// fs.modest
//
// What is at a path: a file, a directory, nothing, ... - without
// struct stat and the S_IS* macros.  Darwin only, like libc/stat.

pragma c_include "dirent.h"

include "libc/ctypes64"
include "libc/stat"
include "libc/stdio"
include "libc/unistd"


// kind of a file system object
public type Kind = @branded Nat8
public const kindNone = Kind 0          // nothing at the path
public const kindFile = Kind 1          // regular file
public const kindDir = Kind 2           // directory
public const kindLink = Kind 3          // symbolic link (kindNoFollow only)
public const kindCharDevice = Kind 4
public const kindBlockDevice = Kind 5
public const kindFifo = Kind 6
public const kindSocket = Kind 7
public const kindOther = Kind 8         // a kind not listed above
public const kindError = Kind 255       // cannot tell: no permission, etc.

// longest path mkdirAll accepts, including the terminating '\0' (PATH_MAX)
public const pathMax = Nat32 1024

// errno values (Darwin) that mean "there is nothing at the path"
const errNoent = Int32 2   // ENOENT: no such file or directory
const errNotdir = Int32 20 // ENOTDIR: a path component is not a directory

// errno location on Darwin; libc/errno binds the glibc one (BUG#107)
@extern("__error")
func errnoLocation () -> *Int32

// directory stream (Darwin, 64-bit inodes); lib/dirent has the glibc layout
@extern("DIR")
type Dir

@alias("struct dirent", backend="c11")
@c_no_print
type Dirent = {
	@alias("d_ino") ino: Nat64
	@alias("d_seekoff") seekoff: Nat64
	@alias("d_reclen") reclen: Nat16
	@alias("d_namlen") namlen: Nat16
	@alias("d_type") type: Nat8
	@alias("d_name") name: [1024]Char8
}

@extern @c_no_print
func opendir (path: *Str8) -> *Dir
@extern @c_no_print
func readdir (dir: *Dir) -> *Dirent
@extern @c_no_print
func closedir (dir: *Dir) -> @unused Int


// kind of what stat/lstat returned r for
func kindOfStat (r: Int, st: *Stat) -> Kind {
	if r != 0 {
		let e = *errnoLocation()
		if e == errNoent or e == errNotdir {
			return kindNone
		}
		return kindError
	}

	let t = st.st_mode & sIfmt
	if t == sIfreg {
		return kindFile
	} else if t == sIfdir {
		return kindDir
	} else if t == sIflnk {
		return kindLink
	} else if t == sIfchr {
		return kindCharDevice
	} else if t == sIfblk {
		return kindBlockDevice
	} else if t == sIfifo {
		return kindFifo
	} else if t == sIfsock {
		return kindSocket
	}
	return kindOther
}


// kind of the object at path; a symbolic link is followed to its target
public func kind (path: *Str8) -> Kind {
	var st: Stat
	let r = stat(path, &st)
	return kindOfStat(r, &st)
}


// kind of the object at path; a symbolic link is reported as kindLink
public func kindNoFollow (path: *Str8) -> Kind {
	var st: Stat
	let r = lstat(path, &st)
	return kindOfStat(r, &st)
}


// is there anything at path (a dangling symbolic link is not)
public func exists (path: *Str8) -> Bool {
	let k = kind(path)
	return k != kindNone and k != kindError
}


// is path a regular file (or a symbolic link to one)
public func isFile (path: *Str8) -> Bool {
	return kind(path) == kindFile
}


// is path a directory (or a symbolic link to one)
public func isDir (path: *Str8) -> Bool {
	return kind(path) == kindDir
}


// create directory path along with all missing parents, like mkdir -p;
// true if path is a directory afterwards
public func mkdirAll (path: *Str8, mode: Word16) -> Bool {
	var buf: [pathMax]Char8
	var i = Nat32 0
	while true {
		let c = path[i]
		// a prefix ends at each '/' (except the root one) and at the end
		if (c == "/" and i > 0) or c == "\x00" {
			buf[i] = "\x00"
			if not isDir(&buf) {
				if mkdir(&buf, mode) != 0 and not isDir(&buf) {
					return false
				}
			}
		}
		if c == "\x00" {
			return true
		}
		if i + 1 >= pathMax {
			return false
		}
		buf[i] = c
		i += 1
	}
	return false
}


// is name "." or ".."
func isDotName (name: *Str8) -> Bool {
	if name[0] != "." {
		return false
	}
	return name[1] == "\x00" or (name[1] == "." and name[2] == "\x00")
}


// remove everything inside directory path; false on the first failure
func removeEntries (path: *Str8) -> Bool {
	var buf: [pathMax]Char8
	// a pass may miss entries when the directory changes under readdir,
	// so pass again until one finds nothing left
	while true {
		let dir = opendir(path)
		if dir == nil {
			return false
		}
		var removed = Nat32 0
		var e = readdir(dir)
		while e != nil {
			if not isDotName(&e.name) {
				let n = snprintf(&buf, SizeT pathMax, "%s/%s", path, &e.name)
				if n < 0 or Nat32 n >= pathMax or not removeAll(&buf) {
					closedir(dir)
					return false
				}
				removed += 1
			}
			e = readdir(dir)
		}
		closedir(dir)
		if removed == 0 {
			return true
		}
	}
	return false
}


// remove path with everything under it, like rm -rf; a symbolic link is
// removed itself, never followed; true if nothing is at path afterwards
public func removeAll (path: *Str8) -> Bool {
	let k = kindNoFollow(path)
	if k == kindNone {
		return true
	}
	if k == kindDir {
		if not removeEntries(path) {
			return false
		}
		return rmdir(path) == 0
	}
	return unlink(path) == 0
}

