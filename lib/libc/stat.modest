@alias("S_ISUID", backend="c11") public const sIsuid: ModeT = 0x0800      // (0004000) set user id on execution
@alias("S_ISGID", backend="c11") public const sIsgid: ModeT = 0x0400      // (0002000) set group id on execution
@alias("S_ISTXT", backend="c11") public const sIstxt: ModeT = 0x0200      // (0001000) sticky bit

@alias("S_IRWXU", backend="c11") public const sIrwxu: ModeT = 0x01C0    // (0000700) RWX mask for owner
@alias("S_IRUSR", backend="c11") public const sIrusr: ModeT = 0x0100    // (0000400) R for owner
@alias("S_IWUSR", backend="c11") public const sIwusr: ModeT = 0x0080    // (0000200) W for owner
@alias("S_IXUSR", backend="c11") public const sIxusr: ModeT = 0x0040    // (0000100) X for owner

@alias("S_IRWXG", backend="c11") public const sIrwxg: ModeT = 0x0038    // (0000070) RWX mask for group
@alias("S_IRGRP", backend="c11") public const sIrgp: ModeT = 0x0020    // (0000040) R for group
@alias("S_IWGRP", backend="c11") public const sIwriteg: ModeT = 0x0010    // (0000020) W for group
@alias("S_IXGRP", backend="c11") public const sIexecg: ModeT = 0x0008    // (0000010) X for group

@alias("S_IRWXO", backend="c11") public const sIrwxo: ModeT = 0x0007    // (0000007) RWX mask for other
@alias("S_IROTH", backend="c11") public const sIro: ModeT = 0x0004    // (0000004) R for other
@alias("S_IWOTH", backend="c11") public const sIwo: ModeT = 0x0002    // (0000002) W for other
@alias("S_IXOTH", backend="c11") public const sIxo: ModeT = 0x0001    // (0000001) X for other
@alias("S_IFIFO", backend="c11") public const sIfifo: ModeT = 0x1000    // (0010000) named pipe (fifo)
@alias("S_IFCHR", backend="c11") public const sIfchr: ModeT = 0x2000    // (0020000) character special
@alias("S_IFDIR", backend="c11") public const sIfdir: ModeT = 0x4000    // (0040000) directory
@alias("S_IFBLK", backend="c11") public const sIfblk: ModeT = 0x6000    // (0060000) block special
@alias("S_IFREG", backend="c11") public const sIfreg: ModeT = 0x8000    // (0100000) regular
@alias("S_IFLNK", backend="c11") public const sIflnk: ModeT = 0xA000    // (0120000) symbolic link
@alias("S_IFSOCK", backend="c11") public const sIfsock: ModeT = 0xC000  // (0140000) socket
@alias("S_IFWHT", backend="c11") public const sIfwht: ModeT = 0xE000    // (0160000) whiteout
@alias("S_ISVTX", backend="c11") public const sIsvtx: ModeT = 0x0200    // (0001000) save swapped text even after use
@alias("S_IREAD", backend="c11") public const sIread: ModeT = sIrusr
@alias("S_IWRITE", backend="c11") public const sIwrite: ModeT = sIwusr
@alias("S_IEXEC", backend="c11") public const sIexec: ModeT = sIxusr
@alias("S_IFMT", backend="c11") public const sIfmt: ModeT = 0xF000      // (0170000) type of file mask

/* is directory */
@alias("S_ISDIR", backend="c11") public func sIsdir (m: ModeT) -> Bool { return m & sIfmt == sIfdir }

/* is char special */
@alias("S_ISCHR", backend="c11") public func sIschr (m: ModeT) -> Bool { return m & sIfmt == sIfchr }

/* is block special */
@alias("S_ISBLK", backend="c11") public func sIsblk (m: ModeT) -> Bool { return m & sIfmt == sIfblk }

/* is regular file */
@alias("S_ISREG", backend="c11") public func sIsreg (m: ModeT) -> Bool { return m & sIfmt == sIfreg }

/* is fifo or socket */
@alias("S_ISFIFO", backend="c11") public func sIsfifo (m: ModeT) -> Bool { return m & sIfmt == sIfifo }

/* is symbolic link */
@alias("S_ISLNK", backend="c11") public func sIslnk (m: ModeT) -> Bool { return m & sIfmt == sIflnk }

/* is socket */
@alias("S_ISSOCK", backend="c11") public func sIssock (m: ModeT) -> Bool { return m & sIfmt == sIfsock }

/* is whiteout */
@alias("S_ISWHT", backend="c11") public func sIswht (m: ModeT) -> Bool { return m & sIfmt == sIfwht }

