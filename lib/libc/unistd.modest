// libc/unistd.modest
// thx: https://pubs.opengroup.org/onlinepubs/7908799/xsh/unistd.h.html

pragma do_not_include
pragma prefix ""
pragma c_include "unistd.h"


include "libc/ctypes64"


//@extern("C)
//var environ: *[]*Char

//@extern("C", "SEEK_SET")
//public const seekSet = 0
//@extern("C", "SEEK_CUR")
//public const seekCur = 1
//@extern("C", "SEEK_END")
//public const seekEnd = 2

@extern("C", "STDIN_FILENO")
public const c_STDIN_FILENO: Int = 0
@extern("C", "STDOUT_FILENO")
public const c_STDOUT_FILENO: Int = 1
@extern("C", "STDERR_FILENO")
public const c_STDERR_FILENO: Int = 2


// lockf function - record locking on files
@extern("C", "F_ULOCK")
public const c_F_ULOCK: Int = 0  // unlock locked sections
@extern("C", "F_LOCK")
public const c_F_LOCK: Int = 1   // lock a section for exclusive use
@extern("C", "F_TLOCK")
public const c_F_TLOCK: Int = 2  // test and lock a section for exclusive use
@extern("C", "F_TEST")
public const c_F_TEST: Int = 3

@extern("C", "F_OK")
public const c_F_OK: Int = 0  // Test for existence of file
@extern("C", "R_OK")
public const c_R_OK: Int = 4  // Test for read permission
@extern("C", "W_OK")
public const c_W_OK: Int = 2  // Test for write permission
@extern("C", "X_OK")
public const c_X_OK: Int = 1  // Test for execute (search) permission



