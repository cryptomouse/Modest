// libc/ctypes32.modest

pragma do_not_include
pragma prefix ""


@alias("char *", backend="c11")
public type Str = Str8

@alias("char", backend="c11")
public type Char = Char8

@alias("const char", backend="c11")
public type ConstChar = Char

@alias("signed char", backend="c11")
public type SignedChar = Int8

@alias("unsigned char", backend="c11")
public type UnsignedChar = Nat8

@alias("short", backend="c11")
public type Short = Int16

@alias("unsigned short", backend="c11")
public type UnsignedShort = Nat16

@alias("int", backend="c11")
public type Int = Int32

@alias("unsigned int", backend="c11")
public type UnsignedInt = Nat32

@alias("long int", backend="c11")
public type LongInt = Int32

@alias("unsigned long int", backend="c11")
public type UnsignedLongInt = Nat32

@alias("long", backend="c11")
public type Long = Int32

@alias("unsigned long", backend="c11")
public type UnsignedLong = Nat32

@alias("long long", backend="c11")
public type LongLong = Int64

@alias("unsigned long long", backend="c11")
public type UnsignedLongLong = Nat64

@alias("long long int", backend="c11")
public type LongLongInt = Int64

@alias("unsigned long long int", backend="c11")
public type UnsignedLongLongInt = Nat64

@alias("float", backend="c11")
public type Float = Float32

@alias("double", backend="c11")
public type Double = Float64

@alias("long double", backend="c11")
public type LongDouble = Float64

@alias("size_t", backend="c11")
public type SizeT = UnsignedLongInt

@alias("ssize_t", backend="c11")
public type SSizeT = LongInt

@alias("intptr_t", backend="c11")
public type IntPtrT = Nat32

@alias("ptrdiff_t", backend="c11")
public type PtrDiffT = Int32

@alias("off_t", backend="c11")
public type OffT = Int32

@alias("useconds_t", backend="c11")
public type USecondsT = Nat32

@alias("pid_t", backend="c11")
public type PIDT = Int32

@alias("uid_t", backend="c11")
public type UIDT = Nat32

@alias("gid_t", backend="c11")
public type GIDT = Nat32

