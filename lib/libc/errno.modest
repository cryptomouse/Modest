/*
 * libc/errno.modest
 */

//pragma prefix ""


import "errno_abi"


public type Errno = Int32


public func get () -> Int32 { return *errno_abi.__errno_location() }
public func set (value: Int32) -> Unit { *errno_abi.__errno_location() = value }

/*
 * Error codes
 */
@extern("C", "EPERM") public const ePerm: Errno = 1     // Operation not permitted
@extern("C", "ENOENT") public const eNoent: Errno = 2    // No such file or directory
@extern("C", "ESRCH") public const eSrch: Errno = 3     // No such process
@extern("C", "EINTR") public const eIntr: Errno = 4     // Interrupted system call
@extern("C", "EIO") public const eIo: Errno = 5       // Input/output error
@extern("C", "ENXIO") public const eNxio: Errno = 6     // Device not configured
@extern("C", "E2BIG") public const e2Big: Errno = 7     // Argument list too long
@extern("C", "ENOEXEC") public const eNoexec: Errno = 8   // Exec format error
@extern("C", "EBADF") public const eBadf: Errno = 9     // Bad file descriptor
@extern("C", "ECHILD") public const eChild: Errno = 10   // No child processes
@extern("C", "EDEADLK") public const eDeadlk: Errno = 11  // Resource deadlock avoided (11 was EAGAIN)
@extern("C", "ENOMEM") public const eNomem: Errno = 12   // Cannot allocate memory
@extern("C", "EACCES") public const eAccess: Errno = 13   // Permission denied
@extern("C", "EFAULT") public const eFault: Errno = 14   // Bad address
@extern("C", "ENOTBLK") public const eNotblk: Errno = 15  // Block device required
@extern("C", "EBUSY") public const eBusy: Errno = 16    // Device / Resource busy
@extern("C", "EEXIST") public const eExist: Errno = 17   // File exists
@extern("C", "EXDEV") public const eXdev: Errno = 18    // Cross-device link
@extern("C", "ENODEV") public const eNodev: Errno = 19   // Operation not supported by device
@extern("C", "ENOTDIR") public const eNotdir: Errno = 20  // Not a directory
@extern("C", "EISDIR") public const eIsdir: Errno = 21   // Is a directory
@extern("C", "EINVAL") public const eInval: Errno = 22   // Invalid argument
@extern("C", "ENFILE") public const eNfile: Errno = 23   // Too many open files in system
@extern("C", "EMFILE") public const eMfile: Errno = 24   // Too many open files
@extern("C", "ENOTTY") public const eNotty: Errno = 25   // Inappropriate ioctl for device
@extern("C", "ETXTBSY") public const eTxtbsy: Errno = 26  // Text file busy
@extern("C", "EFBIG") public const eFbig: Errno = 27    // File too large
@extern("C", "ENOSPC") public const eNospc: Errno = 28   // No space left on device
@extern("C", "ESPIPE") public const eSpipe: Errno = 29   // Illegal seek
@extern("C", "EROFS") public const eRofs: Errno = 30    // Read-only file system
@extern("C", "EMLINK") public const eMlink: Errno = 31   // Too many links
@extern("C", "EPIPE") public const ePipe: Errno = 32    // Broken pipe
@extern("C", "EDOM") public const eDom: Errno = 33     // Numerical argument out of domain
@extern("C", "ERANGE") public const eRange: Errno = 34   // Result too large

/* non-blocking and interrupt i/o */
@extern("C", "EAGAIN") public const eAgain: Errno = 35           // Resource temporarily unavailable
@extern("C", "EWOULDBLOCK") public const eWouldblock: Errno = eAgain  // Operation would block
@extern("C", "EINPROGRESS") public const eInprogress: Errno = 36      // Operation now in progress
@extern("C", "EALREADY") public const eAlready: Errno = 37         // Operation already in progress

/* ipc/network software -- argument errors */
@extern("C", "ENOTSOCK") public const eNotsock: Errno = 38         // Socket operation on non-socket
@extern("C", "EDESTADDRREQ") public const eDestaddrreq: Errno = 39     // Destination address required
@extern("C", "EMSGSIZE") public const eMsgsize: Errno = 40         // Message too long
@extern("C", "EPROTOTYPE") public const ePrototype: Errno = 41       // Protocol wrong type for socket
@extern("C", "ENOPROTOOPT") public const eNoprotoopt: Errno = 42      // Protocol not available
@extern("C", "EPROTONOSUPPORT") public const eProtonosupport: Errno = 43  // Protocol not supported
@extern("C", "ESOCKTNOSUPPORT") public const eSocktnosupport: Errno = 44  // Socket type not supported
@extern("C", "ENOTSUP") public const eNotsup: Errno = 45          // Operation not supported
@extern("C", "EPFNOSUPPORT") public const ePfnosupport: Errno = 46     // Protocol family not supported
@extern("C", "EAFNOSUPPORT") public const eAfnosupport: Errno = 47     // Address family not supported by protocol family
@extern("C", "EADDRINUSE") public const eAddrinuse: Errno = 48       // Address already in use
@extern("C", "EADDRNOTAVAIL") public const eAddrnotavail: Errno = 49    // Can't assign requested address

/* ipc/network software -- operational errors */
@extern("C", "ENETDOWN") public const eNetdown: Errno = 50         // Network is down
@extern("C", "ENETUNREACH") public const eNetunreach: Errno = 51      // Network is unreachable
@extern("C", "ENETRESET") public const eNetreset: Errno = 52        // Network dropped connection on reset
@extern("C", "ECONNABORTED") public const eConnaborted: Errno = 53     // Software caused connection abort
@extern("C", "ECONNRESET") public const eConnreset: Errno = 54       // Connection reset by peer
@extern("C", "ENOBUFS") public const eNobufs: Errno = 55          // No buffer space available
@extern("C", "EISCONN") public const eIsconn: Errno = 56          // Socket is already connected
@extern("C", "ENOTCONN") public const eNotconn: Errno = 57         // Socket is not connected
@extern("C", "ESHUTDOWN") public const eShutdown: Errno = 58        // Can't send after socket shutdown
@extern("C", "ETOOMANYREFS") public const eToomanyrefs: Errno = 59     // Too many references: can't splice
@extern("C", "ETIMEDOUT") public const eTimedout: Errno = 60        // Operation timed out
@extern("C", "ECONNREFUSED") public const eConnrefused: Errno = 61     // Connection refused
@extern("C", "ELOOP") public const eLoop: Errno = 62            // Too many levels of symbolic links
@extern("C", "ENAMETOOLONG") public const eNametoolong: Errno = 63     // File name too long

/* should be rearranged */
@extern("C", "EHOSTDOWN") public const eHostdown: Errno = 64        // Host is down
@extern("C", "EHOSTUNREACH") public const eHostunreach: Errno = 65     // No route to host
@extern("C", "ENOTEMPTY") public const eNotempty: Errno = 66        // Directory not empty

/* quotas & mush */
//public const eProclim: Errno = 67  // Too many processes
//public const eUsers: Errno = 68    // Too many users
@extern("C", "EDQUOT") public const eDquot: Errno = 69           // Disc quota exceeded

/* Network File System */
@extern("C", "ESTALE") public const eStale: Errno = 70           // Stale NFS file handle
//public const eRemote: Errno = 71  // Too many levels of remote in path
//public const eBadrpc: Errno = 72  // RPC struct is bad
//public const eRpcmismatch: Errno = 73   // RPC version wrong
//public const eProgunavail: Errno = 74   // RPC prog. not avail
//public const eProgmismatch: Errno = 75  // Program version wrong
//public const eProcunavail: Errno = 76   // Bad procedure for program

@extern("C", "ENOLCK") public const eNolck: Errno = 77           // No locks available
@extern("C", "ENOSYS") public const eNosys: Errno = 78           // Function not implemented

//public const eFtype: Errno = 79     // Inappropriate file type or format
//public const eAuth: Errno = 80      // Authentication error
//public const eNeedauth: Errno = 81  // Need authenticator
//
///* Intelligent device errors */
//public const ePwroff: Errno = 82  // Device power is off
//public const eDeverr: Errno = 83  // Device error, e.g. paper out

@extern("C", "EOVERFLOW") public const eOverflow: Errno = 84        // Value too large to be stored in data type

/* Program loading errors */
//public const eBadexec: Errno = 85    // Bad executable
//public const eBadarch: Errno = 86    // Bad CPU type in executable
//public const eShlibvers: Errno = 87  // Shared library version mismatch
//public const eBadmacho: Errno = 88   // Malformed Macho file

@extern("C", "ECANCELED") public const eCanceled: Errno = 89        // Operation canceled

@extern("C", "EIDRM") public const eIdrm: Errno = 90            // Identifier removed
@extern("C", "ENOMSG") public const eNomsg: Errno = 91           // No message of desired type
@extern("C", "EILSEQ") public const eIlseq: Errno = 92           // Illegal byte sequence

//public const eNoattr: Errno = 93  // Attribute not found

@extern("C", "EBADMSG") public const eBadmsg: Errno = 94          // Bad message
@extern("C", "EMULTIHOP") public const eMultihop: Errno = 95        // Reserved
@extern("C", "ENODATA") public const eNodata: Errno = 96          // No message available on STREAM
@extern("C", "ENOLINK") public const eNolink: Errno = 97          // Reserved
@extern("C", "ENOSR") public const eNosr: Errno = 98            // No STREAM resources
@extern("C", "ENOSTR") public const eNostr: Errno = 99           // Not a STREAM
@extern("C", "EPROTO") public const eProto: Errno = 100          // Protocol error
@extern("C", "ETIME") public const eTime: Errno = 101           // STREAM ioctl timeout
@extern("C", "EOPNOTSUPP") public const eOpnotsupp: Errno = 102      // Operation not supported on socket
@extern("C", "ENOPOLICY") public const eNopolicy: Errno = 103       // No such policy registered

/* pseudo-errors returned inside kernel to modify return to process */
@extern("C", "ERESTART") public const eRestart: Errno = -1         // restart syscall
@extern("C", "EJUSTRETURN") public const eJustreturn: Errno = -2      // don't modify regs, just return

