/*
 * libc/errno.modest
 */

//pragma prefix ""


import "errno_abi"


public type Errno = Int32


public func get () -> Int32 { return *errno_abi.__errno_location() }

public func set (value: Int32) -> Unit { *errno_abi.__errno_location() = value }

/*
 * Error codes
 */
@alias("EPERM", backend="c11") public const ePerm: Errno = 1     // Operation not permitted
@alias("ENOENT", backend="c11") public const eNoent: Errno = 2    // No such file or directory
@alias("ESRCH", backend="c11") public const eSrch: Errno = 3     // No such process
@alias("EINTR", backend="c11") public const eIntr: Errno = 4     // Interrupted system call
@alias("EIO", backend="c11") public const eIo: Errno = 5       // Input/output error
@alias("ENXIO", backend="c11") public const eNxio: Errno = 6     // Device not configured
@alias("E2BIG", backend="c11") public const e2Big: Errno = 7     // Argument list too long
@alias("ENOEXEC", backend="c11") public const eNoexec: Errno = 8   // Exec format error
@alias("EBADF", backend="c11") public const eBadf: Errno = 9     // Bad file descriptor
@alias("ECHILD", backend="c11") public const eChild: Errno = 10   // No child processes
@alias("EDEADLK", backend="c11") public const eDeadlk: Errno = 11  // Resource deadlock avoided (11 was EAGAIN)
@alias("ENOMEM", backend="c11") public const eNomem: Errno = 12   // Cannot allocate memory
@alias("EACCES", backend="c11") public const eAccess: Errno = 13   // Permission denied
@alias("EFAULT", backend="c11") public const eFault: Errno = 14   // Bad address
@alias("ENOTBLK", backend="c11") public const eNotblk: Errno = 15  // Block device required
@alias("EBUSY", backend="c11") public const eBusy: Errno = 16    // Device / Resource busy
@alias("EEXIST", backend="c11") public const eExist: Errno = 17   // File exists
@alias("EXDEV", backend="c11") public const eXdev: Errno = 18    // Cross-device link
@alias("ENODEV", backend="c11") public const eNodev: Errno = 19   // Operation not supported by device
@alias("ENOTDIR", backend="c11") public const eNotdir: Errno = 20  // Not a directory
@alias("EISDIR", backend="c11") public const eIsdir: Errno = 21   // Is a directory
@alias("EINVAL", backend="c11") public const eInval: Errno = 22   // Invalid argument
@alias("ENFILE", backend="c11") public const eNfile: Errno = 23   // Too many open files in system
@alias("EMFILE", backend="c11") public const eMfile: Errno = 24   // Too many open files
@alias("ENOTTY", backend="c11") public const eNotty: Errno = 25   // Inappropriate ioctl for device
@alias("ETXTBSY", backend="c11") public const eTxtbsy: Errno = 26  // Text file busy
@alias("EFBIG", backend="c11") public const eFbig: Errno = 27    // File too large
@alias("ENOSPC", backend="c11") public const eNospc: Errno = 28   // No space left on device
@alias("ESPIPE", backend="c11") public const eSpipe: Errno = 29   // Illegal seek
@alias("EROFS", backend="c11") public const eRofs: Errno = 30    // Read-only file system
@alias("EMLINK", backend="c11") public const eMlink: Errno = 31   // Too many links
@alias("EPIPE", backend="c11") public const ePipe: Errno = 32    // Broken pipe
@alias("EDOM", backend="c11") public const eDom: Errno = 33     // Numerical argument out of domain
@alias("ERANGE", backend="c11") public const eRange: Errno = 34   // Result too large

/* non-blocking and interrupt i/o */
@alias("EAGAIN", backend="c11") public const eAgain: Errno = 35           // Resource temporarily unavailable
@alias("EWOULDBLOCK", backend="c11") public const eWouldblock: Errno = eAgain  // Operation would block
@alias("EINPROGRESS", backend="c11") public const eInprogress: Errno = 36      // Operation now in progress
@alias("EALREADY", backend="c11") public const eAlready: Errno = 37         // Operation already in progress

/* ipc/network software -- argument errors */
@alias("ENOTSOCK", backend="c11") public const eNotsock: Errno = 38         // Socket operation on non-socket
@alias("EDESTADDRREQ", backend="c11") public const eDestaddrreq: Errno = 39     // Destination address required
@alias("EMSGSIZE", backend="c11") public const eMsgsize: Errno = 40         // Message too long
@alias("EPROTOTYPE", backend="c11") public const ePrototype: Errno = 41       // Protocol wrong type for socket
@alias("ENOPROTOOPT", backend="c11") public const eNoprotoopt: Errno = 42      // Protocol not available
@alias("EPROTONOSUPPORT", backend="c11") public const eProtonosupport: Errno = 43  // Protocol not supported
@alias("ESOCKTNOSUPPORT", backend="c11") public const eSocktnosupport: Errno = 44  // Socket type not supported
@alias("ENOTSUP", backend="c11") public const eNotsup: Errno = 45          // Operation not supported
@alias("EPFNOSUPPORT", backend="c11") public const ePfnosupport: Errno = 46     // Protocol family not supported
@alias("EAFNOSUPPORT", backend="c11") public const eAfnosupport: Errno = 47     // Address family not supported by protocol family
@alias("EADDRINUSE", backend="c11") public const eAddrinuse: Errno = 48       // Address already in use
@alias("EADDRNOTAVAIL", backend="c11") public const eAddrnotavail: Errno = 49    // Can't assign requested address

/* ipc/network software -- operational errors */
@alias("ENETDOWN", backend="c11") public const eNetdown: Errno = 50         // Network is down
@alias("ENETUNREACH", backend="c11") public const eNetunreach: Errno = 51      // Network is unreachable
@alias("ENETRESET", backend="c11") public const eNetreset: Errno = 52        // Network dropped connection on reset
@alias("ECONNABORTED", backend="c11") public const eConnaborted: Errno = 53     // Software caused connection abort
@alias("ECONNRESET", backend="c11") public const eConnreset: Errno = 54       // Connection reset by peer
@alias("ENOBUFS", backend="c11") public const eNobufs: Errno = 55          // No buffer space available
@alias("EISCONN", backend="c11") public const eIsconn: Errno = 56          // Socket is already connected
@alias("ENOTCONN", backend="c11") public const eNotconn: Errno = 57         // Socket is not connected
@alias("ESHUTDOWN", backend="c11") public const eShutdown: Errno = 58        // Can't send after socket shutdown
@alias("ETOOMANYREFS", backend="c11") public const eToomanyrefs: Errno = 59     // Too many references: can't splice
@alias("ETIMEDOUT", backend="c11") public const eTimedout: Errno = 60        // Operation timed out
@alias("ECONNREFUSED", backend="c11") public const eConnrefused: Errno = 61     // Connection refused
@alias("ELOOP", backend="c11") public const eLoop: Errno = 62            // Too many levels of symbolic links
@alias("ENAMETOOLONG", backend="c11") public const eNametoolong: Errno = 63     // File name too long

/* should be rearranged */
@alias("EHOSTDOWN", backend="c11") public const eHostdown: Errno = 64        // Host is down
@alias("EHOSTUNREACH", backend="c11") public const eHostunreach: Errno = 65     // No route to host
@alias("ENOTEMPTY", backend="c11") public const eNotempty: Errno = 66        // Directory not empty

/* quotas & mush */
//public const eProclim: Errno = 67  // Too many processes
//public const eUsers: Errno = 68    // Too many users
@alias("EDQUOT", backend="c11") public const eDquot: Errno = 69           // Disc quota exceeded

/* Network File System */
@alias("ESTALE", backend="c11") public const eStale: Errno = 70           // Stale NFS file handle
//public const eRemote: Errno = 71  // Too many levels of remote in path
//public const eBadrpc: Errno = 72  // RPC struct is bad
//public const eRpcmismatch: Errno = 73   // RPC version wrong
//public const eProgunavail: Errno = 74   // RPC prog. not avail
//public const eProgmismatch: Errno = 75  // Program version wrong
//public const eProcunavail: Errno = 76   // Bad procedure for program

@alias("ENOLCK", backend="c11") public const eNolck: Errno = 77           // No locks available
@alias("ENOSYS", backend="c11") public const eNosys: Errno = 78           // Function not implemented

//public const eFtype: Errno = 79     // Inappropriate file type or format
//public const eAuth: Errno = 80      // Authentication error
//public const eNeedauth: Errno = 81  // Need authenticator
//
///* Intelligent device errors */
//public const ePwroff: Errno = 82  // Device power is off
//public const eDeverr: Errno = 83  // Device error, e.g. paper out

@alias("EOVERFLOW", backend="c11") public const eOverflow: Errno = 84        // Value too large to be stored in data type

/* Program loading errors */
//public const eBadexec: Errno = 85    // Bad executable
//public const eBadarch: Errno = 86    // Bad CPU type in executable
//public const eShlibvers: Errno = 87  // Shared library version mismatch
//public const eBadmacho: Errno = 88   // Malformed Macho file

@alias("ECANCELED", backend="c11") public const eCanceled: Errno = 89        // Operation canceled

@alias("EIDRM", backend="c11") public const eIdrm: Errno = 90            // Identifier removed
@alias("ENOMSG", backend="c11") public const eNomsg: Errno = 91           // No message of desired type
@alias("EILSEQ", backend="c11") public const eIlseq: Errno = 92           // Illegal byte sequence

//public const eNoattr: Errno = 93  // Attribute not found

@alias("EBADMSG", backend="c11") public const eBadmsg: Errno = 94          // Bad message
@alias("EMULTIHOP", backend="c11") public const eMultihop: Errno = 95        // Reserved
@alias("ENODATA", backend="c11") public const eNodata: Errno = 96          // No message available on STREAM
@alias("ENOLINK", backend="c11") public const eNolink: Errno = 97          // Reserved
@alias("ENOSR", backend="c11") public const eNosr: Errno = 98            // No STREAM resources
@alias("ENOSTR", backend="c11") public const eNostr: Errno = 99           // Not a STREAM
@alias("EPROTO", backend="c11") public const eProto: Errno = 100          // Protocol error
@alias("ETIME", backend="c11") public const eTime: Errno = 101           // STREAM ioctl timeout
@alias("EOPNOTSUPP", backend="c11") public const eOpnotsupp: Errno = 102      // Operation not supported on socket
@alias("ENOPOLICY", backend="c11") public const eNopolicy: Errno = 103       // No such policy registered

/* pseudo-errors returned inside kernel to modify return to process */
@alias("ERESTART", backend="c11") public const eRestart: Errno = -1         // restart syscall
@alias("EJUSTRETURN", backend="c11") public const eJustreturn: Errno = -2      // don't modify regs, just return

