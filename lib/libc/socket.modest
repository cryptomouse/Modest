// libc/socket.modest

pragma do_not_include
pragma prefix ""
pragma c_include "arpa/inet.h"
//pragma c_include "sys/socket.h"

include "libc/ctypes64"


@alias("in_addr_t", backend="c11")
public type InAddrT = Nat32

@alias("INADDR_ANY", backend="c11")
public const inAddrAny: InAddrT = 0

@alias("in_port_t", backend="c11")
public type InPortT = Nat16

@alias("socklen_t", backend="c11")
public type SocklenT = Nat32

@alias("struct sockaddr", backend="c11")
public type SockAddr = @public {
	sa_family: UnsignedShort  // address family
	sa_data: [14]Char8        // up to 14 bytes of direct address
}

@alias("struct in_addr", backend="c11")
public type Struct_in_addr = @public {
	s_addr: InAddrT
}

@alias("struct sockaddr_in", backend="c11")
public type SockAddrIn = @public {
// $if APPLE
	sin_len: Nat8
	sin_family: Nat8
// $else
//sin_family: Short
// $endif APPLE
	sin_port: UnsignedShort
	sin_addr: Struct_in_addr
	sin_zero: [8]Nat8
}

@alias("SOL_SOCKET", backend="c11")
public const solSocket: Int = 1   // for setsockopt

@alias("SO_REUSEADDR", backend="c11")
public const soReuseaddr: Int = 2


// from "sys/socket.h"

public func setsockopt (
	socket: Int, level: Int,
	option_name: Int, option_value: Ptr,
	option_len: SocklenT
) -> @unused Int


@alias("SOCK_STREAM", backend="c11") public const sockStream: Int = 1  // stream socket
@alias("SOCK_DGRAM", backend="c11") public const sockDgram: Int = 2   // datagram socket
@alias("SOCK_RAW", backend="c11") public const sockRaw: Int = 3     // raw-protocol interface
@alias("SOCK_RDM", backend="c11") public const sockRdm: Int = 4     // reliably-delivered message
@alias("SOCK_SEQPACKET", backend="c11") public const sockSeqpacket: Int = 5  // sequenced packet stream
//#ifdef _KERNEL
//const SOCK_TYPE_MASK = 0x000F	// mask that covers the above
//#endif

/*
 * Address families.
 */

public type AddressFamily = Nat8

@alias("AF_UNSPEC", backend="c11") public const afUnspec = AddressFamily 0       // unspecified
@alias("AF_UNIX", backend="c11") public const afUnix = AddressFamily 1         // local to host
@alias("AF_LOCAL", backend="c11") public const afLocal = afUnix   // draft POSIX compatibility

@alias("AF_INET", backend="c11") public const afInet = AddressFamily 2         // internetwork: UDP, TCP, etc.

@alias("AF_IMPLINK", backend="c11") public const afImplink = AddressFamily 3      // arpanet imp addresses
@alias("AF_PUP", backend="c11") public const afPup = AddressFamily 4          // pup protocols: e.g. BSP
@alias("AF_CHAOS", backend="c11") public const afChaos = AddressFamily 5        // mit CHAOS protocols
@alias("AF_NS", backend="c11") public const afNs = AddressFamily 6           // XEROX NS protocols
@alias("AF_ISO", backend="c11") public const afIso = AddressFamily 7          // ISO protocols
@alias("AF_OSI", backend="c11") public const afOsi = AddressFamily 7      // OSI protocols
@alias("AF_ECMA", backend="c11") public const afEcma = AddressFamily 8         // european computer manufacturers
@alias("AF_DATKIT", backend="c11") public const afDatakit = AddressFamily 9      // datakit protocols
@alias("AF_CCITT", backend="c11") public const afCcitt = AddressFamily 10       // CCITT protocols, X.25 etc
@alias("AF_SNA", backend="c11") public const afSna = AddressFamily 11         // IBM SNA
@alias("AF_DECNET", backend="c11") public const afDecnet = AddressFamily 12      // DECnet
@alias("AF_DLI", backend="c11") public const afDli = AddressFamily 13         // DEC Direct data link interface
@alias("AF_LAT", backend="c11") public const afLat = AddressFamily 14         // LAT
@alias("AF_HYLINK", backend="c11") public const afHylink = AddressFamily 15      // NSC Hyperchannel
@alias("AF_APPLETALK", backend="c11") public const afAppletalk = AddressFamily 16   // Apple Talk
@alias("AF_ROUTE", backend="c11") public const afRoute = AddressFamily 17       // Internal Routing Protocol
@alias("AF_LINK", backend="c11") public const afLink = AddressFamily 18        // Link layer interface
@alias("AF_XTP", backend="c11") public const pseudoAfXtp = AddressFamily 19   // eXpress Transfer Protocol (no AF)
@alias("AF_COIP", backend="c11") public const afCoip = AddressFamily 20        // connection-oriented IP, aka ST II
@alias("AF_CNT", backend="c11") public const afCnt = AddressFamily 21         // Computer Network Technology
@alias("AF_RTIP", backend="c11") public const pseudoAfRtip = AddressFamily 22  // Help Identify RTIP packets
@alias("AF_IPX", backend="c11") public const afIpx = AddressFamily 23         // Novell Internet Protocol
@alias("AF_INET6", backend="c11") public const afInet6 = AddressFamily 24       // IPv6
@alias("AF_PIP", backend="c11") public const pseudoAfPip = AddressFamily 25   // Help Identify PIP packets
@alias("AF_ISDN", backend="c11") public const afIsdn = AddressFamily 26        // Integrated Services Digital Network*/
@alias("AF_E164", backend="c11") public const afE164 = AddressFamily 26    // CCITT E.164 recommendation
@alias("AF_NATM", backend="c11") public const afNatm = AddressFamily 27        // native ATM access
@alias("AF_ENCAP", backend="c11") public const afEncap = AddressFamily 28       //
@alias("AF_SIP", backend="c11") public const afSip = AddressFamily 29         // Simple Internet Protocol
@alias("AF_KEY", backend="c11") public const afKey = AddressFamily 30
// Used by BPF to not rewrite headers
// in interface output routine
@alias("AF_HDRCMPLT", backend="c11") public const pseudoAfHdrcmplt = AddressFamily 31
@alias("AF_BLUETOOTH", backend="c11") public const afBluetooth = AddressFamily 32     // Bluetooth
@alias("AF_MPLS", backend="c11") public const afMpls = AddressFamily 33          // MPLS
@alias("AF_PFLOW", backend="c11") public const pseudoAfPflow = AddressFamily 34   // pflow
@alias("AF_PIPEX", backend="c11") public const pseudoAfPipex = AddressFamily 35   // PIPEX
@alias("AF_MAX", backend="c11") public const afMax = AddressFamily 36


public func inet_addr (cp: *[]ConstChar) -> InAddrT

/*
func inet_lnaof (in: Struct_in_addr) -> InAddrT
func inet_makeaddr (net: InAddrT, lna: InAddrT) -> Struct_in_addr
func inet_netof (in: Struct_in_addr) -> InAddrT
func inet_network (cp: *ConstChar) -> InAddrT
func inet_ntoa (in: Struct_in_addr) -> *Char
*/

public func socket (domain: AddressFamily, _type: Int, protocol: Int) -> Int
public func bind (socket: Int, addr: *SockAddr, addrlen: SocklenT) -> Int
public func listen (socket: Int, backlog: Int) -> Int
public func connect (socket: Int, addr: *SockAddr, addrlen: SocklenT) -> Int

public func send (socket: Int, buf: Ptr, len: SizeT, flags: Int) -> @unused SSizeT
public func recv (socket: Int, buf: Ptr, len: SizeT, flags: Int) -> @unused SSizeT

// вообще syscall, разберись
public func accept (socket: Int, addr: *SockAddr, addrlen: *SocklenT) -> Int

