// limits.modest
//

pragma do_not_include
pragma prefix ""
pragma c_include "limits.h"


@extern("C", "INT8_MIN")
public const int8MinValue: Int8  = -128
@extern("C", "INT8_MAX")
public const int8MaxValue: Int8  = 127

@extern("C", "INT16_MIN")
public const int16MinValue: Int16 = -32768
@extern("C", "INT16_MAX")
public const int16MaxValue: Int16 = 32767

@extern("C", "INT32_MIN")
public const int32MinValue: Int32 = -2147483648
@extern("C", "INT32_MAX")
public const int32MaxValue: Int32 = 2147483647

@extern("C", "INT64_MIN")
public const int64MinValue: Int64 = -9223372036854775808
@extern("C", "INT64_MAX")
public const int64MaxValue: Int64 = 9223372036854775807

@cbyvalue
public const int128MinValue: Int128 = -170141183460469231731687303715884105728
@cbyvalue
public const int128MaxValue: Int128 = 170141183460469231731687303715884105727


@cbyvalue
public const nat8MinValue: Nat8  = 0
@extern("C", "UINT8_MAX")
public const nat8MaxValue: Nat8  = 255

@cbyvalue
public const nat16MinValue: Nat16 = 0
@extern("C", "UINT16_MAX")
public const nat16MaxValue: Nat16 = 65535

@cbyvalue
public const nat32MinValue: Nat32 = 0
@extern("C", "UINT32_MAX")
public const nat32MaxValue: Nat32 = 4294967295

@cbyvalue
public const nat64MinValue: Nat64 = 0
@extern("C", "UINT64_MAX")
public const nat64MaxValue: Nat64 = 18446744073709551615

@cbyvalue
public const nat128MinValue: Nat128 = 0
@cbyvalue
public const nat128MaxValue: Nat128 = 340282366920938463463374607431768211455


