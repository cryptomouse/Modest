// libc/termios.modest

pragma do_not_include
pragma prefix ""
pragma c_include "termios.h"


type Int = Int32
type Nat = Nat32
type CC_T = Char8 //Char
type SpeedT = Nat //UnsignedInt
type TCFlagT = Word32


// Special Control Characters
public const c_VEOF: Nat8 = 0     // ICANON
public const c_VEOL: Nat8 = 1     // ICANON
public const c_VERASE: Nat8 = 3   // ICANON
public const c_VKILL: Nat8 = 5    // ICANON
public const c_VINTR: Nat8 = 8    // ISIG
public const c_VQUIT: Nat8 = 9    // ISIG
public const c_VSUSP: Nat8 = 10   // ISIG
public const c_VSTART: Nat8 = 12  // IXON, IXOFF
public const c_VSTOP: Nat8 = 13   // IXON, IXOFF
public const c_VMIN: Nat8 = 16    // !ICANON
public const c_VTIME: Nat8 = 17   // !ICANON


// Input flags - software input processing
public const c_IGNBRK: TCFlagT = 0x00000001  // ignore BREAK condition
public const c_BRKINT: TCFlagT = 0x00000002  // map BREAK to SIGINT
public const c_IGNPAR: TCFlagT = 0x00000004  // ignore (discard) parity errors
public const c_PARMRK: TCFlagT = 0x00000008  // mark parity and framing errors
public const c_INPCK: TCFlagT = 0x00000010   // enable checking of parity errors
public const c_ISTRIP: TCFlagT = 0x00000020  // strip 8th bit off chars
public const c_INLCR: TCFlagT = 0x00000040   // map NL into CR
public const c_IGNCR: TCFlagT = 0x00000080   // ignore CR
public const c_ICRNL: TCFlagT = 0x00000100   // map CR to NL (ala CRMOD)
public const c_IXON: TCFlagT = 0x00000200    // enable output flow control
public const c_IXOFF: TCFlagT = 0x00000400   // enable input flow control


// Output flags - software output processing

public const c_OPOST: TCFlagT = 0x00000001   // enable following output processing


// Control flags - hardware control of terminal

public const c_CSIZE: TCFlagT = 0x00000300   // character size mask
public const c_CS5: TCFlagT = 0x00000000     // 5 bits (pseudo)
public const c_CS6: TCFlagT = 0x00000100     // 6 bits
public const c_CS7: TCFlagT = 0x00000200     // 7 bits
public const c_CS8: TCFlagT = 0x00000300     // 8 bits
public const c_CSTOPB: TCFlagT = 0x00000400  // send 2 stop bits
public const c_CREAD: TCFlagT = 0x00000800   // enable receiver
public const c_PARENB: TCFlagT = 0x00001000  // parity enable
public const c_PARODD: TCFlagT = 0x00002000  // odd parity, else even
public const c_HUPCL: TCFlagT = 0x00004000   // hang up on last close
public const c_CLOCAL: TCFlagT = 0x00008000  // ignore modem status lines

public const c_ECHOE: TCFlagT = 0x00000002   // visually erase chars
public const c_ECHOK: TCFlagT = 0x00000004   // echo NL after line kill
public const c_ECHO: TCFlagT = 0x00000008    // enable echoing
public const c_ECHONL: TCFlagT = 0x00000010  // echo NL even if ECHO is off
public const c_ISIG: TCFlagT = 0x00000080    // enable signals INTR, QUIT, [D]SUSP
public const c_ICANON: TCFlagT = 0x00000100  // canonicalize input lines
public const c_IEXTEN: TCFlagT = 0x00000400  // enable DISCARD and LNEXT
public const c_EXTPROC: TCFlagT = 0x00000800 // external processing
public const c_TOSTOP: TCFlagT = 0x00400000  // stop background jobs from output
public const c_NOFLSH: TCFlagT = 0x80000000  // don't flush after interrupt


const c_NCCS = 20

public type Termios = {
	public c_iflag:  TCFlagT       // input flags
	public c_oflag:  TCFlagT       // output flags
	public c_cflag:  TCFlagT       // control flags
	public c_lflag:  TCFlagT       // local flags
	public c_cc:     [c_NCCS]CC_T  // control chars
	public c_ispeed: Int           // input speed
	public c_ospeed: Int           // output speed
}


// Commands passed to tcsetattr() for setting the termios structure
public const c_TCSANOW: Int = 0    // make change immediate
public const c_TCSADRAIN: Int = 1  // drain output, then change
public const c_TCSAFLUSH: Int = 2  // drain output, flush input


// Standard speeds

public const c_B0: SpeedT = 0
public const c_B50: SpeedT = 50
public const c_B75: SpeedT = 75
public const c_B110: SpeedT = 110
public const c_B134: SpeedT = 134
public const c_B150: SpeedT = 150
public const c_B200: SpeedT = 200
public const c_B300: SpeedT = 300
public const c_B600: SpeedT = 600
public const c_B1200: SpeedT = 1200
public const c_B1800: SpeedT = 1800
public const c_B2400: SpeedT = 2400
public const c_B4800: SpeedT = 4800
public const c_B7200: SpeedT = 7200
public const c_B9600: SpeedT = 9600
public const c_B14400: SpeedT = 14400
public const c_B19200: SpeedT = 19200
public const c_B28800: SpeedT = 28800
public const c_B38400: SpeedT = 38400
public const c_B57600: SpeedT = 57600
public const c_B76800: SpeedT = 76800
public const c_B115200: SpeedT = 115200
public const c_B230400: SpeedT = 230400
public const c_B460800: SpeedT = 460800
public const c_B500000: SpeedT = 500000
public const c_B576000: SpeedT = 576000
public const c_B921600: SpeedT = 921600
public const c_B1000000: SpeedT = 1000000
public const c_B1152000: SpeedT = 1152000
public const c_B1500000: SpeedT = 1500000
public const c_B2000000: SpeedT = 2000000
public const c_B2500000: SpeedT = 2500000
public const c_B3000000: SpeedT = 3000000
public const c_B3500000: SpeedT = 3500000
public const c_B4000000: SpeedT = 4000000


public const c_TCIFLUSH: Int = 1
public const c_TCOFLUSH: Int = 2
public const c_TCIOFLUSH: Int = 3
public const c_TCOOFF: Int = 1
public const c_TCOON: Int = 2
public const c_TCIOFF: Int = 3
public const c_TCION: Int = 4


public func cfgetispeed: (termios: *Termios) -> SpeedT
public func cfgetospeed: (termios: *Termios) -> SpeedT
public func cfsetispeed: (termios: *Termios, speed: SpeedT) -> Int
public func cfsetospeed: (termios: *Termios, speed: SpeedT) -> Int
public func tcgetattr: (fd: Int, termios: *Termios) -> Int
public func tcsetattr: (fd: Int, opt_act: Int, termios: *Termios) -> Int
public func tcdrain: (fd: Int) -> Int
public func tcflow: (fd: Int, act: Int) -> Int
public func tcflush: (fd: Int, queue_selector: Int) -> Int
public func tcsendbreak: (fd: Int, duration: Int) -> Int
//public func tcgetsid: (fd: Int) -> PidT


