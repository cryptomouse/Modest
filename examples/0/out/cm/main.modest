include "libc/ctypes64"
include "libc/stdio"


type Point = {x: Fixed32, y: Fixed32}

const genericPoint = {x = 1.0, y = 2.0}

const constantPoint: Point = genericPoint
var variablePoint: Point = genericPoint


type Sample = {
	tag: Word8  // 1 byte, then 3 bytes of padding
	value: Int32
}

type Celsius = Fixed32

const freezingPoint = Celsius 0.0

@nonstatic
func main () -> Int {
	printf("Hello World!\n")

	let x = Word8 (Word32 5 & 0xFF)

	printf("constantPoint = {x=%f, y=%f}\n", Float32 constantPoint.x, Float32 constantPoint.y)
	printf("variablePoint = {x=%f, y=%f}\n", Float32 variablePoint.x, Float32 variablePoint.y)
	printf("freezingPoint = %f\n", Float32 freezingPoint)

	var a: Sample = {tag = 0x01, value = 7}
	var b: Sample = {tag = 0x01, value = 7}
	printf("a == b ? %d\n", a == b)
	var u: Word8 = 0xFF
	var k = Int32 u
	printf("k = %d\n", k)

	return 0
}

