include "libc/ctypes64"
include "libc/stdio"

//include "./lib"

const c1 = 1
const c2 = 2


func sum (a: Int32, b: Int32) -> Int32 {
	return a + b
}

const c3: Int32 = sum(c1, c2)

func init () -> Int32 {
	let a: Int32 = sum(c1, c2)
	printf("sum: %d\n", a)
	return 0
}


@nonstatic
func main () -> Int32 {
	init()
	let a: Int32 = sum(c1, c2)
	return 0
}

