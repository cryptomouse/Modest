// examples/0/src/main.modest
pragma unsafe

include "libc/ctypes64"
include "libc/stdio"

//include "./lib"



var a: [10][20]Nat32

var k: Nat32 = 10
var l: Nat32 = 20


func main () -> Int32 {
	let p = *Unit &a

	type MyArray = [k][l]Nat32

	k = 0
	l = 0

	let pa = *MyArray p

	printf("sizeof(MyArray) = %d\n", sizeof(MyArray))
	printf("sizeof(*pa) = %d\n", sizeof(*pa))

	return 0
}

