// examples/0/src/main.modest
pragma unsafe

include "libc/ctypes64"
include "libc/stdio"

//include "./lib"


var a: [4] Int32 = [1, 2, 3, 4]

type F = (Int32) -> Int   // a parameter without a name

func main () -> Int {
	let adr = Nat64 unsafe(Word64 &a[0])
	printf("adr = %llu\n", adr)

	return 0
}

