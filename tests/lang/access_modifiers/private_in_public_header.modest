// TEST: run
// BACKENDS: c11, llvm
// LINK: ./_private_in_public_header/opaque.modest
// EXPECT-OUT: passed: private_in_public_header
//
// A public record of another module, kept by value, whose private fields
// hold that module's private types: an alias, a record pointing to itself,
// a record holding both, an anonymous record holding them.  The importer
// cannot name them, but C needs the complete struct, so `opaque.h` carries
// all of them, in dependency order, ahead of `Opaque`, and `opaque.c` does
// not repeat them; under LLVM the importer's IR defines them too.
// Guards BUG#88 (fixed 2026-11-08).
// Guards BUG#123 (fixed 2026-11-08).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"
import "./_private_in_public_header/opaque"


func main () -> Int {
	var o = opaque.opaque_new(10)
	let sum = opaque.opaque_sum(&o)
	if sum != 46 {
		printf("opaque_sum = %d, expected 46\n", sum)
		return exitFailure
	}

	printf("passed: private_in_public_header\n")
	return exitSuccess
}

