// Fixture for private_in_public_header.modest: a public record whose
// private fields hold this module's private types, each needing the next.

type Hidden = Int32

type Node = record {
	next: *Node
	v: Hidden
}

type Pair = record {
	a: Node
	b: [2]Hidden
}

public type Opaque = record {
	p: Pair
	q: record {
		x: Hidden
		n: *Node
	}
}


public func opaque_new (v: Int32) -> Opaque {
	var o: Opaque
	o.p.a = {next = nil, v = v}
	o.p.b = [v + 1, v + 2]
	o.q = {x = v + 3, n = &o.p.a}
	return o
}

public func opaque_sum (o: *Opaque) -> Int32 {
	return o.p.a.v + o.p.b[0] + o.p.b[1] + o.q.x
}
