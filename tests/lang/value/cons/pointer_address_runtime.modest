// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: pointer from a run-time word
//
// The other side of pointer_address.modest: `*T WordX w` where `w` is only
// known at run time, so the cast is an instruction, not a constant
// expression.  Next to it, the literal forms that pointer_address.modest
// does not cover: a wider word, a zero address and a global initializer.
// Guards BUG#82 (fixed 2026-11-01).

pragma unsafe

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type GPIO = {
	dir: Word8
	out: Word8
}

const zero = unsafe(*GPIO Word16 0)
var gport: *GPIO = unsafe(*GPIO Word16 0x24)


func mk (w: Word16) -> *GPIO {
	return unsafe(*GPIO w)
}


func check (name: *Str8, p: *GPIO, expected: Word64) -> Bool {
	let a = unsafe(Word64 p)
	if a != expected {
		printf("%s = 0x%llx, expected 0x%llx\n", name, Nat64 a, Nat64 expected)
		return false
	}
	return true
}


func main () -> Int {
	var ok = true
	ok = check("mk(0x25)", mk(Word16 0x25), 0x25) and ok
	ok = check("Word32 0x26", unsafe(*GPIO Word32 0x26), 0x26) and ok
	ok = check("zero", zero, 0) and ok
	ok = check("gport", gport, 0x24) and ok

	if not ok {
		printf("failed: pointer from a run-time word\n")
		return exitFailure
	}

	printf("passed: pointer from a run-time word\n")
	return exitSuccess
}

