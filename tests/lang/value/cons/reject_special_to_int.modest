// TEST: reject
// BACKENDS: c11, llvm, modest
// EXPECT-ERROR: integer overflow
// EXPECT-ERROR: attempt to construct `Int32` from `Float`
// EXPECT-ERROR: integer overflow
// EXPECT-ERROR: attempt to construct `Int32` from `Float`
// EXPECT-ERROR: integer overflow
// EXPECT-ERROR: attempt to construct `Nat8` from `Float64`
// EXPECT-ERROR: integer overflow
// EXPECT-ERROR: attempt to construct `Int16` from `Float`
// EXPECT-ERROR-COUNT: 4
//
// A constant NaN or infinity constructed to an integer: neither fits any
// integer type, so it is the same `integer overflow` as `Int8 300.0`
// (reject_fractional_to_int_overflow.modest) — and not a Python traceback
// out of the fold.  `-builtin.inf` written in place is there because the
// negation used to turn the generic Float into a Rational holding -inf,
// which went down a different path to the same traceback.  The `unsafe`
// form is reject_special_to_int_unsafe.modest.  `builtin.nan` itself is a
// generic Float, named `Float` in a diagnostic; `negInf` is a `Float64`.
// Guards BUG#120 (fixed 2026-11-08).

include "libc/ctypes64"


const negInf: Float64 = -builtin.inf


func main () -> Int {
	let a = Int32 builtin.nan
	let b = Int32 builtin.inf
	let c = Nat8 negInf
	let d = Int16 -builtin.inf
	return 0
}

