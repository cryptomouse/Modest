// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECTED-FAIL(llvm): BUG#77 lengthof a slice with run-time bounds emits ill-typed IR
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: lengthof a literal slice
// EXPECT-OUT: passed: lengthof a run-time slice
// EXPECT-OUT: passed: lengthof a slice
//
// The length of `a[i:j]` is `j - i`: a constant when both bounds are, a
// run-time `Size` otherwise.  An open right bound takes the length of the
// array.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func opaque (n: Int32) -> Int32 {
	return n
}


func testLiteral () -> Bool {
	var a: [8]Int32

	if lengthof(a[2:5]) != 3 or lengthof(a[3:]) != 5 or lengthof(a[:4]) != 4 or lengthof(a[:]) != 8 {
		printf("lengthof a literal slice wrong\n")
		return false
	}

	printf("passed: lengthof a literal slice\n")
	return true
}


func testRuntime () -> Bool {
	var a: [8]Int32
	let i = opaque(2)
	let j = opaque(7)

	if lengthof(a[i:j]) != 5 {
		printf("lengthof(a[2:7]) != 5\n")
		return false
	}
	if lengthof(a[i:]) != 6 or lengthof(a[:j]) != 7 {
		printf("lengthof(a[2:]) != 6 or lengthof(a[:7]) != 7\n")
		return false
	}

	printf("passed: lengthof a run-time slice\n")
	return true
}


func main () -> Int {
	var result = true
	result = testLiteral() and result
	result = testRuntime() and result

	if not result {
		printf("failed: lengthof a slice\n")
		return exitFailure
	}

	printf("passed: lengthof a slice\n")
	return exitSuccess
}


