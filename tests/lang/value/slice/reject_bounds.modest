// TEST: reject
// BACKENDS: c11, llvm, modest
// EXPECT-ERROR: expected integral value
// EXPECT-ERROR: expected integral value
// EXPECT-ERROR: wrong slice direction
// EXPECT-ERROR: wrong slice direction
// EXPECT-ERROR: expected array or pointer to array
//
// What a slice refuses to be built from.  A bound is an integer — not a
// `Bool`, not a fraction.  When both bounds are known, `from` may not pass
// `to`; an open right bound is the length of the array, so a start beyond
// it is the same mistake.  And only an array, or a pointer to one, can be
// sliced.

include "libc/ctypes64"


func main () -> Int {
	var a: [8]Int32
	var x: Int32 = 5

	a[true:3] = []
	a[1.5:3] = []
	a[5:2] = []
	a[9:] = []
	x[0:1] = []

	return 0
}


