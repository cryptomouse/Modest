// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: slice into a variable
// EXPECT-OUT: passed: slice as an argument
// EXPECT-OUT: passed: slice of a value in a register
// EXPECT-OUT: passed: slice comparison
// EXPECT-OUT: passed: overlapping copy
// EXPECT-OUT: passed: slice as a value
//
// A slice is an array *value*: it can be stored, passed by value, compared
// and copied, and a copy is a copy — changing it leaves the source alone.
// All the bounds here are literals, so the length of every slice is part
// of its type; run-time bounds are in runtime_value.modest.
//
// Some sources are the less common places a slice can come from — a
// parameter, a `let` bound to a call — values the LLVM backend may hold in
// a register instead of in memory.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func sum3 (a: [3]Int32) -> Int32 {
	return a[0] + a[1] + a[2]
}


func make () -> [5]Int32 {
	return [5]Int32 [1, 2, 3, 4, 5]
}


func middleOf (a: [5]Int32) -> Int32 {
	return sum3(a[1:4])
}


func testVariable () -> Bool {
	var a: [5]Int32 = [1, 2, 3, 4, 5]

	var s = a[1:4]
	if lengthof(s) != 3 or s[0] != 2 or s[2] != 4 {
		printf("s = a[1:4] wrong\n")
		return false
	}

	s[0] = 100
	if a[1] != 2 {
		printf("writing to a copy of a[1:4] changed a[1] to %d\n", a[1])
		return false
	}

	// Typed on the receiving side.
	var t: [2]Int32 = a[3:5]
	if t[0] != 4 or t[1] != 5 {
		printf("t = a[3:5] = [%d, %d], expected [4, 5]\n", t[0], t[1])
		return false
	}

	printf("passed: slice into a variable\n")
	return true
}


func testArgument () -> Bool {
	var a: [5]Int32 = [1, 2, 3, 4, 5]

	if sum3(a[2:5]) != 12 or sum3(a[:3]) != 6 {
		printf("sum3(a[2:5]) = %d, expected 12\n", sum3(a[2:5]))
		return false
	}

	printf("passed: slice as an argument\n")
	return true
}


func testRegisterValue () -> Bool {
	// A parameter.
	if middleOf(make()) != 9 {
		printf("middleOf(make()) = %d, expected 9\n", middleOf(make()))
		return false
	}

	// A let bound to a call result.
	let r = make()
	if sum3(r[2:5]) != 12 {
		printf("sum3(r[2:5]) = %d, expected 12\n", sum3(r[2:5]))
		return false
	}

	printf("passed: slice of a value in a register\n")
	return true
}


func testComparison () -> Bool {
	var a: [6]Int32 = [1, 2, 3, 1, 2, 3]

	if a[0:3] != a[3:6] {
		printf("a[0:3] != a[3:6], expected equal\n")
		return false
	}
	if a[0:2] == a[1:3] {
		printf("a[0:2] == a[1:3], expected different\n")
		return false
	}

	printf("passed: slice comparison\n")
	return true
}


func testOverlap () -> Bool {
	// Source and target share a[1..3]; a copy has to read all of the source
	// before it writes any of the target.  (The C backend emits `memcpy`
	// here, which the C standard leaves undefined for overlapping ranges —
	// this passes because the libc happens to cope, not by construction.)
	var a: [5]Int32 = [1, 2, 3, 4, 5]
	a[0:4] = a[1:5]
	if a[0] != 2 or a[1] != 3 or a[2] != 4 or a[3] != 5 or a[4] != 5 {
		printf("a[0:4] = a[1:5] gave [%d, %d, %d, %d, %d], expected [2, 3, 4, 5, 5]\n",
			a[0], a[1], a[2], a[3], a[4])
		return false
	}

	// Shift right — the direction a naive forward copy gets wrong.
	var b: [5]Int32 = [1, 2, 3, 4, 5]
	b[1:5] = b[0:4]
	if b[0] != 1 or b[1] != 1 or b[2] != 2 or b[3] != 3 or b[4] != 4 {
		printf("b[1:5] = b[0:4] gave [%d, %d, %d, %d, %d], expected [1, 1, 2, 3, 4]\n",
			b[0], b[1], b[2], b[3], b[4])
		return false
	}

	printf("passed: overlapping copy\n")
	return true
}


func main () -> Int {
	var result = true
	result = testVariable() and result
	result = testArgument() and result
	result = testRegisterValue() and result
	result = testComparison() and result
	result = testOverlap() and result

	if not result {
		printf("failed: slice as a value\n")
		return exitFailure
	}

	printf("passed: slice as a value\n")
	return exitSuccess
}


