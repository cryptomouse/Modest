// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: index into a run-time slice of rows
//
// A slice with run-time bounds of an array of rows.  The step of the first
// index after it is a whole row, not one element (runtime_postfix.modest),
// so a wrong step shows up here as the wrong element rather than a crash.
//
// Every bound goes through `opaque`, so it cannot be folded away.
//
// Guards BUG#76 (fixed 2026-10-31).
// Guards BUG#108 (fixed 2026-10-31).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


@impure
func opaque (n: Int32) -> Int32 {
	return n
}


func main () -> Int {
	var g: [4][3]Int32 = [
		[0, 1, 2]
		[10, 11, 12]
		[20, 21, 22]
		[30, 31, 32]
	]
	let i = opaque(1)
	let j = opaque(4)

	// g[1:4] is rows 1..3; its row 1 is g[2].
	if g[i:j][1][2] != 22 or g[i:j][2][0] != 30 {
		printf("g[1:4][1][2], g[1:4][2][0] = %d, %d, expected 22, 30\n", g[i:j][1][2], g[i:j][2][0])
		return exitFailure
	}

	// Written through.
	g[i:j][0][1] = 99
	if g[1][1] != 99 {
		printf("g[1:4][0][1] = 99 left g[1][1] = %d\n", g[1][1])
		return exitFailure
	}

	printf("passed: index into a run-time slice of rows\n")
	return exitSuccess
}
