// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: literal into a run-time slice
// EXPECT-OUT: passed: open bounds
// EXPECT-OUT: passed: bound expressions
// EXPECT-OUT: passed: natural bounds
// EXPECT-OUT: passed: empty run-time slice
// EXPECT-OUT: passed: slice with run-time bounds
//
// Bounds of a slice are ordinary expressions, not constants.  `a[i:j]` with
// `i` and `j` known only at run time is the common case in real code, and
// its length `j - i` is then a run-time number that the backend has to
// compute itself rather than read off the type.
//
// Only writing *into* such a slice is checked here.  Reading one as a value
// is in runtime_value.modest, a postfix after it in runtime_postfix.modest,
// `= []` in zero_fill.modest.
//
// Every bound goes through `opaque`, so it cannot be folded away.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func opaque (n: Int32) -> Int32 {
	return n
}


func opaqueNat (n: Nat32) -> Nat32 {
	return n
}


func opaqueNat8 (n: Nat8) -> Nat8 {
	return n
}


func testLiteralInto () -> Bool {
	var a: [6]Int32 = [1, 2, 3, 4, 5, 6]
	let i = opaque(2)

	// The slice is as long as the literal only at run time.
	a[i:i + 3] = [3]Int32 [30, 40, 50]
	if a[1] != 2 or a[2] != 30 or a[3] != 40 or a[4] != 50 or a[5] != 6 {
		printf("a[i:i + 3] = [30, 40, 50] gave [%d, %d, %d, %d, %d, %d]\n",
			a[0], a[1], a[2], a[3], a[4], a[5])
		return false
	}

	printf("passed: literal into a run-time slice\n")
	return true
}


func testOpenBounds () -> Bool {
	var a: [5]Int32 = [1, 2, 3, 4, 5]
	let i = opaque(3)
	let j = opaque(2)

	// a[i:] runs to the end of the array, a[:j] starts at 0.
	a[i:] = [2]Int32 [40, 50]
	a[:j] = [2]Int32 [10, 20]
	if a[0] != 10 or a[1] != 20 or a[2] != 3 or a[3] != 40 or a[4] != 50 {
		printf("a = [%d, %d, %d, %d, %d], expected [10, 20, 3, 40, 50]\n",
			a[0], a[1], a[2], a[3], a[4])
		return false
	}

	printf("passed: open bounds\n")
	return true
}


func testBoundExpressions () -> Bool {
	var a: [8]Int32 = [0, 1, 2, 3, 4, 5, 6, 7]
	let n = opaque(8)
	let half = n / 2

	// Arithmetic on both sides: a window of two around the middle.
	a[half - 1:half + 1] = [2]Int32 [30, 40]
	if a[2] != 2 or a[3] != 30 or a[4] != 40 or a[5] != 5 {
		printf("a[half - 1:half + 1] wrong: [%d, %d, %d, %d]\n", a[2], a[3], a[4], a[5])
		return false
	}

	// Elements of another array as bounds.
	var idx: [2]Int32 = [6, 8]
	a[idx[0]:idx[1]] = [2]Int32 [60, 70]
	if a[5] != 5 or a[6] != 60 or a[7] != 70 {
		printf("a[idx[0]:idx[1]] wrong: [%d, %d, %d]\n", a[5], a[6], a[7])
		return false
	}

	// Calls as bounds.
	a[opaque(0):opaque(1)] = [1]Int32 [99]
	if a[0] != 99 or a[1] != 1 {
		printf("a[opaque(0):opaque(1)] wrong: [%d, %d]\n", a[0], a[1])
		return false
	}

	printf("passed: bound expressions\n")
	return true
}


func testNaturalBounds () -> Bool {
	var a: [8]Int32 = [0, 1, 2, 3, 4, 5, 6, 7]

	// Nat32 on both sides — misc/sha256 slices with Nat32.
	let i = opaqueNat(2)
	let n = opaqueNat(4)
	a[i:n] = [2]Int32 [20, 30]
	if a[1] != 1 or a[2] != 20 or a[3] != 30 or a[4] != 4 {
		printf("a[i:n] (Nat32) wrong: [%d, %d, %d, %d]\n", a[1], a[2], a[3], a[4])
		return false
	}

	// Nat8 against a literal and against the implicit length.
	let k = opaqueNat8(6)
	a[k:8] = [2]Int32 [60, 70]
	if a[5] != 5 or a[6] != 60 or a[7] != 70 {
		printf("a[k:8] (Nat8) wrong: [%d, %d, %d]\n", a[5], a[6], a[7])
		return false
	}
	a[k:] = [2]Int32 [61, 71]
	if a[6] != 61 or a[7] != 71 {
		printf("a[k:] (Nat8) wrong: [%d, %d]\n", a[6], a[7])
		return false
	}

	printf("passed: natural bounds\n")
	return true
}


func testEmpty () -> Bool {
	var a: [4]Int32 = [1, 2, 3, 4]
	var b: [4]Int32 = [5, 6, 7, 8]
	let i = opaque(2)

	// `i:i` is zero elements long: nothing is copied either way.
	a[i:i] = b[i:i]
	if a[0] != 1 or a[1] != 2 or a[2] != 3 or a[3] != 4 {
		printf("a[i:i] = b[i:i] changed a: [%d, %d, %d, %d]\n", a[0], a[1], a[2], a[3])
		return false
	}

	printf("passed: empty run-time slice\n")
	return true
}


func main () -> Int {
	var result = true
	result = testLiteralInto() and result
	result = testOpenBounds() and result
	result = testBoundExpressions() and result
	result = testNaturalBounds() and result
	result = testEmpty() and result

	if not result {
		printf("failed: slice with run-time bounds\n")
		return exitFailure
	}

	printf("passed: slice with run-time bounds\n")
	return exitSuccess
}


