// TEST: reject
// EXPECT-ERROR: unsuitable value type 'Word32' for 'neg' operation
// EXPECT-ERROR: unsuitable value type 'Word32' for 'pos' operation
// EXPECT-ERROR: unsuitable value type 'Bool' for 'neg' operation
// EXPECT-ERROR: unsuitable value type 'Bool' for 'pos' operation
//
// `-` and `+` take a number: IntX, FloatX, or an untyped Integer literal.
//
// The signedness half of this rule is in reject.modest — `-n` and `+n` on a
// NatX.  This file is the other half: a `WordX` is a bit pattern rather than
// a quantity, so it has no negation, and a Bool is not a number at all.
//
// `-w` is the one with a plausible-looking answer: it wraps, and both
// backends agreed on 0xfffffffb for `-5` at Word32, so nothing downstream
// reported anything.  That is the reason to refuse it at the front.
//
// Guards BUG#64 (fixed 2026-09-29).

include "libc/ctypes64"

func main () -> Int {
	var w: Word32 = 5
	var negWord = -w
	var posWord = +w

	var t: Bool = true
	var negBool = -t
	var posBool = +t

	return 0
}
