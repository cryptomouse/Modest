// TEST: reject
// EXPECT-ERROR: unsuitable value type 'Word32' for 'logical-not' operation
// EXPECT-ERROR: unsuitable value type 'Int32' for 'logical-not' operation
// EXPECT-ERROR: unsuitable value type 'Nat32' for 'logical-not' operation
// EXPECT-ERROR: unsuitable value type 'Float64' for 'logical-not' operation
//
// `not` is the Bool operator and takes nothing else.
//
// Decided 2026-09-07 and written into docs/lang/value/unary.md: `not` and
// `~` are two operators rather than two spellings of one, and neither
// crosses to the other's type.  `not` on a WordX is the case that was
// *removed* rather than merely refused — it used to compile, and it is what
// the documentation used to promise; `~w` is the spelling that survives.
//
// Each site is refused by modest itself.  Before the check every line here
// compiled: the integer ones with a meaning the language does not define
// (`not 5` was a bitwise -6), the float one only to be rejected by clang or
// llvm-as with a diagnostic about the generated code.
//
// Guards BUG#64 (fixed 2026-09-29).

include "libc/ctypes64"

func main () -> Int {
	// The spelling this rule retires.  `~w` is the one that survives, and
	// bitwise.modest uses it throughout.
	var w: Word32 = 0xA5
	var onWord = not w

	// An integer is a quantity, not a condition and not a bit pattern.
	// Today this is a bitwise inversion: `not 5` gives -6.
	var i: Int32 = 5
	var onInt = not i

	var n: Nat32 = 5
	var onNat = not n

	// A float has no bit-inversion to fall back on: this one used to reach
	// the backend and come back as a clang or llvm-as diagnostic.
	var f: Float64 = 1.5
	var onFloat = not f

	return 0
}
