// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: own width
// EXPECT-OUT: passed: not wider
// EXPECT-OUT: passed: narrower
// EXPECT-OUT: passed: any spelling
// EXPECT-OUT: passed: literal tilde
//
// `~` applied to a *bare* literal.
//
// A literal has no type, but it has a width: the fewest bits that hold its
// value, and never fewer than one — `0xA5` is 8 bits, `0x0F` is 4, `0x1FF`
// is 9, `0` is 1.  `~` inverts it there, and the result is a literal again:
// `~0xA5` is `0x5A`, `~0` is `1`.
//
// Its top bit is always set, so `~` always clears it: `~0x0F` and `~0xFF`
// are `0`.  That is not C's `~0xFF` — a full-width mask is written with its
// type, `~Word32 0xFF` (literal_width.modest).
//
// The result never grows past that width: constructed into a wider Word,
// `~0xA5` is `0x0000005A`.  It may shrink, and then the next `~` works at
// the narrower width — `~~0xA5` is `~0x5A`, 7 bits, which is `0x25`.
//
// A negative literal has no such width and is refused
// (literal/reject_bitwise.modest).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


const inverted = ~0xA5


func testOwnWidth () -> Bool {
	var a: Word8 = ~0xA5
	var b: Word8 = ~0xF0
	if a != 0x5A or b != 0x0F {
		printf("~0xA5 / ~0xF0 = 0x%02x / 0x%02x, expected 0x5A / 0x0F\n", Word32 a, Word32 b)
		return false
	}

	// Four bits, all set: nothing is left.
	var c: Word8 = ~0x0F
	var d: Word16 = ~0x1FF
	if c != 0x00 or d != 0x0000 {
		printf("~0x0F / ~0x1FF = 0x%02x / 0x%04x, expected 0\n", Word32 c, Word32 d)
		return false
	}

	// 0x10 is five bits, 0x100 is nine.
	var e: Word8 = ~0x10
	var f: Word16 = ~0x100
	if e != 0x0F or f != 0x00FF {
		printf("~0x10 / ~0x100 = 0x%02x / 0x%04x, expected 0x0F / 0x00FF\n", Word32 e, Word32 f)
		return false
	}

	// Zero is written with one bit, so its inversion is one.
	var z: Word8 = ~0
	var o: Word8 = ~1
	if z != 0x01 or o != 0x00 {
		printf("~0 / ~1 = 0x%02x / 0x%02x, expected 0x01 / 0x00\n", Word32 z, Word32 o)
		return false
	}

	// 64 bits: the fold does not lose the upper half.
	var g: Word64 = ~0x8000000000000000
	if g != 0x7FFFFFFFFFFFFFFF {
		printf("~0x8000000000000000 = 0x%016llx, expected 0x7FFFFFFFFFFFFFFF\n", Nat64 g)
		return false
	}

	printf("passed: own width\n")
	return true
}


func testNotWider () -> Bool {
	// In a Word32 the upper bits stay zero: the literal was 8 bits wide.
	var a: Word32 = ~0xA5
	if a != 0x0000005A {
		printf("~0xA5 as Word32 = 0x%08x, expected 0x0000005A\n", a)
		return false
	}

	// The same through a constant, which stays a literal.
	var b: Word16 = inverted
	var c: Word64 = inverted
	if b != 0x005A or c != 0x000000000000005A {
		printf("const ~0xA5 = 0x%04x / 0x%llx, expected 0x5A\n", Word32 b, Nat64 c)
		return false
	}

	// Meeting a wider Word: the literal is inverted before it meets `m`.
	var m: Word32 = 0xFFFFFFFF
	if m & ~0xF0 != 0x0000000F {
		printf("0xFFFFFFFF & ~0xF0 = 0x%08x, expected 0x0000000F\n", m & ~0xF0)
		return false
	}

	// The typed form is how the full-width mask is written.
	if m & ~Word32 0xF0 != 0xFFFFFF0F {
		printf("0xFFFFFFFF & ~Word32 0xF0 = 0x%08x, expected 0xFFFFFF0F\n", m & ~Word32 0xF0)
		return false
	}

	printf("passed: not wider\n")
	return true
}


func testNarrower () -> Bool {
	// A 16-bit literal whose inversion fits a byte.
	var a: Word8 = ~0xFF0F
	if a != 0xF0 {
		printf("~0xFF0F as Word8 = 0x%02x, expected 0xF0\n", Word32 a)
		return false
	}

	// The second `~` works at the width the first one left: 0x5A is 7 bits.
	var b: Word8 = ~~0xA5
	var c: Word8 = ~~0x0F
	if b != 0x25 or c != 0x01 {
		printf("~~0xA5 / ~~0x0F = 0x%02x / 0x%02x, expected 0x25 / 0x01\n", Word32 b, Word32 c)
		return false
	}

	printf("passed: narrower\n")
	return true
}


func testAnySpelling () -> Bool {
	// A folded expression is a literal of the same width as the value
	// written out: 0x0F + 0 is four bits like 0x0F, and 0x80 | 0x01 is
	// eight bits like 0x81.
	var a: Word8 = ~(0x0F + 0)
	var b: Word8 = ~(0x80 | 0x01)
	var c: Word8 = ~(0x0F & 0xF0)
	if a != 0x00 or b != 0x7E or c != 0x01 {
		printf("~(0x0F + 0) / ~(0x80 | 0x01) / ~(0x0F & 0xF0) = 0x%02x / 0x%02x / 0x%02x, expected 0x00 / 0x7E / 0x01\n",
			Word32 a, Word32 b, Word32 c)
		return false
	}

	printf("passed: any spelling\n")
	return true
}


func main () -> Int {
	var ok = testOwnWidth()
	ok = testNotWider() and ok
	ok = testNarrower() and ok
	ok = testAnySpelling() and ok
	if not ok {
		return exitFailure
	}
	printf("passed: literal tilde\n")
	return exitSuccess
}
