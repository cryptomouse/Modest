// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: hex
// EXPECT-OUT: passed: decimal
// EXPECT-OUT: passed: not wider
// EXPECT-OUT: passed: any spelling
// EXPECT-OUT: passed: literal tilde
//
// `~` applied to a *bare* literal.
//
// A literal has a width, and `~` inverts it there; the result is a literal
// again.  A hex literal is as wide as it is written (literal/hex_width.modest):
// `~0x0F` is `0xF0`, `~0x0000000F` is `0xFFFFFFF0`, `~0xF` is `0`, `~0x0` is
// `0xF`.  The result keeps that width, so `~~` gives the literal back.
//
// A decimal literal is as wide as its value, never less than one bit: `~0` is
// `1`.  Its top bit is always set, so `~` always clears it, and the result
// may be narrower — `~~165` is `~90`, 7 bits, which is `37`.
//
// The result never grows past the width: constructed into a wider Word,
// `~0x0F` is `0x000000F0`.  A full-width mask is written to the width, or
// with its type — `~Word32 0x0F` (literal_width.modest).
//
// A negative literal has no such width and is refused
// (literal/reject_bitwise.modest).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


const inverted = ~0x0F


func testHex () -> Bool {
	var a: Word8 = ~0x0F
	var b: Word8 = ~0xA5
	if a != 0xF0 or b != 0x5A {
		printf("~0x0F / ~0xA5 = 0x%02x / 0x%02x, expected 0xF0 / 0x5A\n", Word32 a, Word32 b)
		return false
	}

	// Written to the full width of the type, the mask is the full one.
	var c: Word32 = ~0x0000000F
	var d: Word16 = ~0x00FF
	if c != 0xFFFFFFF0 or d != 0xFF00 {
		printf("~0x0000000F / ~0x00FF = 0x%08x / 0x%04x\n", c, Word32 d)
		return false
	}

	// Without leading zeros the written width is the value's: all set.
	var e: Word8 = ~0xF
	var f: Word8 = ~0x7
	var g: Word16 = ~0x1FF
	if e != 0x0 or f != 0x0 or g != 0x0 {
		printf("~0xF / ~0x7 / ~0x1FF = 0x%x / 0x%x / 0x%x, expected 0\n", Word32 e, Word32 f, Word32 g)
		return false
	}

	// 0x0 is one digit, four bits.
	var z: Word8 = ~0x0
	if z != 0x0F {
		printf("~0x0 = 0x%02x, expected 0x0F\n", Word32 z)
		return false
	}

	// Twice is the identity: the width is kept.
	var t: Word8 = ~~0xA5
	var u: Word8 = ~~0x0F
	if t != 0xA5 or u != 0x0F {
		printf("~~0xA5 / ~~0x0F = 0x%02x / 0x%02x\n", Word32 t, Word32 u)
		return false
	}

	// 64 bits: the fold does not lose the upper half.
	var w: Word64 = ~0x0000FFFF0000FFFF
	if w != 0xFFFF0000FFFF0000 {
		printf("~0x0000FFFF0000FFFF = 0x%016llx\n", Nat64 w)
		return false
	}

	printf("passed: hex\n")
	return true
}


func testDecimal () -> Bool {
	var a: Word8 = ~0
	var b: Word8 = ~1
	var c: Word8 = ~165
	if a != 1 or b != 0 or c != 90 {
		printf("~0 / ~1 / ~165 = %u / %u / %u, expected 1 / 0 / 90\n", Nat32 a, Nat32 b, Nat32 c)
		return false
	}

	// The result is as wide as its own value: 90 is 7 bits.
	var d: Word8 = ~~165
	if d != 37 {
		printf("~~165 = %u, expected 37\n", Nat32 d)
		return false
	}

	printf("passed: decimal\n")
	return true
}


func testNotWider () -> Bool {
	// In a Word32 the upper bits stay zero: the literal was 8 bits wide.
	var a: Word32 = ~0x0F
	if a != 0x000000F0 {
		printf("~0x0F as Word32 = 0x%08x, expected 0x000000F0\n", a)
		return false
	}

	// The same through a constant, which stays a literal.
	var b: Word16 = inverted
	var c: Word64 = inverted
	if b != 0x00F0 or c != 0x00000000000000F0 {
		printf("const ~0x0F = 0x%04x / 0x%llx, expected 0xF0\n", Word32 b, Nat64 c)
		return false
	}

	// Meeting a wider Word: the literal is inverted before it meets `m`.
	var m: Word32 = 0xFFFFFFFF
	if m & ~0x0F != 0x000000F0 {
		printf("0xFFFFFFFF & ~0x0F = 0x%08x, expected 0x000000F0\n", m & ~0x0F)
		return false
	}

	// Written to the width, or typed, it is the full-width mask.
	if m & ~0x0000000F != 0xFFFFFFF0 or m & ~Word32 0x0F != 0xFFFFFFF0 {
		printf("0xFFFFFFFF & ~0x0000000F / ~Word32 0x0F is not 0xFFFFFFF0\n")
		return false
	}

	printf("passed: not wider\n")
	return true
}


func testAnySpelling () -> Bool {
	// `|` keeps the hex width, so the folded pair inverts like the literal
	// written out; arithmetic gives the width of the value.
	var a: Word8 = ~(0x0F | 0x00)
	var b: Word8 = ~(0x80 | 0x01)
	var c: Word8 = ~(0x0F + 0)
	if a != 0xF0 or b != 0x7E or c != 0x00 {
		printf("~(0x0F | 0x00) / ~(0x80 | 0x01) / ~(0x0F + 0) = 0x%02x / 0x%02x / 0x%02x, expected 0xF0 / 0x7E / 0x00\n",
			Word32 a, Word32 b, Word32 c)
		return false
	}

	printf("passed: any spelling\n")
	return true
}


func main () -> Int {
	var ok = testHex()
	ok = testDecimal() and ok
	ok = testNotWider() and ok
	ok = testAnySpelling() and ok
	if not ok {
		return exitFailure
	}
	printf("passed: literal tilde\n")
	return exitSuccess
}

