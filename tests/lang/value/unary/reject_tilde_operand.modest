// TEST: reject
// EXPECT-ERROR: unsuitable value type 'Bool' for 'bitwise-not' operation
// EXPECT-ERROR: unsuitable value type 'Int32' for 'bitwise-not' operation
// EXPECT-ERROR: unsuitable value type 'Nat32' for 'bitwise-not' operation
// EXPECT-ERROR: unsuitable value type 'Float64' for 'bitwise-not' operation
//
// `~` is the Word operator and takes nothing else.
//
// The other half of the split decided on 2026-09-07: bit manipulation is
// defined for `Word*` and for no other type, which is the same line
// docs/CHEATSHEET.md draws for the binary `&`, `|` and `^`, and with the
// same diagnostic.  A bare literal is refused too — that one is in
// literal/reject_bitwise.modest.
//
// Guards BUG#64 (fixed 2026-09-29).

include "libc/ctypes64"

func main () -> Int {
	// Bool has `not` and nothing else.  This gives false today, by
	// inverting the single bit.
	var t: Bool = true
	var onBool = ~t

	var i: Int32 = 5
	var onInt = ~i

	var n: Nat32 = 5
	var onNat = ~n

	// The one that does not even survive code generation: modest accepts it
	// and clang answers `invalid argument type 'double' to unary
	// expression`, which names the C type and not the Modest one.
	var f: Float64 = 1.5
	var onFloat = ~f

	return 0
}
