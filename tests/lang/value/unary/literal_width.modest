// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: literal width
//
// `~` applied to a *typed literal*.
//
// A bare literal is inverted at its own minimal width — `~0x0F` is `0`,
// four bits all cleared, wherever it goes; see literal_tilde.modest.  Written
// with its type, `~Word32 0x0F` is the complement of a 32-bit `0x0000000F`
// and has to be `0xFFFFFFF0`, however few bits the literal itself needs.
//
// The LLVM backend used to size an untyped literal to its own value first —
// `0x0F` fits eight bits — invert it there, and zero-extend the result, so
// every bit above the literal's width came back 0 instead of 1.  The typed
// form is how a mask is written now, so this file checks that the type, not
// the literal, decides the width.
//
// The same expression over a variable is repeated at the end, so that a
// failure here names the literal.
//
// Guards BUG#63 (fixed 2026-09-29).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func main () -> Int {
	// A literal that fits a byte, inverted as a 32-bit value.
	var a: Word32 = ~Word32 0x0F
	if a != 0xFFFFFFF0 {
		printf("~Word32 0x0F = 0x%08x, expected 0xFFFFFFF0\n", a)
		return exitFailure
	}

	// Spelled to the full width, which changes nothing: the leading zeros
	// of a literal are not part of its value.
	var b: Word32 = ~Word32 0x0000000F
	if a != b {
		printf("~Word32 0x0F and ~Word32 0x0000000F differ: 0x%08x vs 0x%08x\n", a, b)
		return exitFailure
	}

	// The case where a wrong answer is not merely wrong but empty.
	var c: Word32 = ~Word32 0x0000FFFF
	if c != 0xFFFF0000 {
		printf("~Word32 0x0000FFFF = 0x%08x, expected 0xFFFF0000\n", c)
		return exitFailure
	}

	// At Word64, where thirty-two more bits would go missing.
	var d: Word64 = ~Word64 0x0F
	if d != 0xFFFFFFFFFFFFFFF0 {
		printf("~Word64 0x0F = 0x%016llx, expected 0xFFFFFFFFFFFFFFF0\n", d)
		return exitFailure
	}

	// Used directly rather than stored, in case a store were what fixed it.
	var mask: Word32 = 0xFFFFFFFF
	if mask & ~Word32 0x0F != 0xFFFFFFF0 {
		printf("0xFFFFFFFF & ~Word32 0x0F = 0x%08x, expected 0xFFFFFFF0\n",
			mask & ~Word32 0x0F)
		return exitFailure
	}

	// The clearing idiom: a flag word with one bit taken out by a mask.
	var flags: Word32 = 0x000000FF
	if flags & ~Word32 0x04 != 0x000000FB {
		printf("0xFF & ~Word32 0x04 = 0x%08x, expected 0xFB\n", flags & ~Word32 0x04)
		return exitFailure
	}

	// Folded at compile time through a constant.
	const low = ~Word32 0x0F
	var e: Word32 = low
	if e != 0xFFFFFFF0 {
		printf("const ~Word32 0x0F = 0x%08x, expected 0xFFFFFFF0\n", e)
		return exitFailure
	}

	// The contrast: the same value through a variable.
	var lit: Word32 = 0x0F
	if ~lit != a {
		printf("~lit = 0x%08x but ~Word32 0x0F = 0x%08x\n", ~lit, a)
		return exitFailure
	}

	printf("passed: literal width\n")
	return exitSuccess
}
