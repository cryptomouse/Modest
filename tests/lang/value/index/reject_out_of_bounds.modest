// TEST: reject
// BACKENDS: c11, llvm, modest
// EXPECT-ERROR: array index must be non-negative
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
// EXPECT-ERROR: array index out of bounds
//
// A literal index has to land inside the array whenever the array's length
// is known — not only when the array is itself a constant.  A variable, an
// element of a two-dimensional array, a record field, a pointer to a sized
// array and a slice with literal bounds all have a length, and `len` is
// already one past the end.  Reading is checked as well as writing.
//
// Not checked, because there is no length to compare with: a pointer to an
// unsized array (`*[]T`) and a slice with run-time bounds.
//
// Covers UB#2.

include "libc/ctypes64"


type Box = {f: [4]Int32}

const c = [3]Int32 [1, 2, 3]


func main () -> Int {
	var a: [8]Int32
	var m: [2][3]Int32
	var box: Box
	let p = &a

	a[-1] = 0
	a[8] = 0
	a[100] = 0
	let x = a[8]
	m[2][0] = 0
	m[1][3] = 0
	box.f[4] = 0
	p[8] = 0
	a[1:5][4] = 0
	let y = c[3]

	return 0
}

