// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: two run-time indexes
// EXPECT-OUT: passed: run-time and compile-time index
// EXPECT-OUT: passed: two compile-time indexes
// EXPECT-OUT: passed: field of a nested record
// EXPECT-OUT: passed: slice of a field
// EXPECT-OUT: passed: index in a loop
// EXPECT-OUT: passed: field of value paths
//
// The other ways into an array field of a record returned by value, next
// to the plain `holderValue().items[i]` of field_of_value.modest: several
// indexes at once, a record nested in the returned one, a slice instead of
// an index, and an index evaluated over and over in a loop.
//
// Guards BUG#101 (fixed 2026-10-11).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type Inner = {items: [3]Int32}
type Outer = {tag: Int32, inner: Inner, grid: [2][3]Int32}

var outer: Outer = {
	tag = 7
	inner = {items = [100, 200, 300]}
	grid = [[1, 2, 3], [4, 5, 6]]
}


func outerValue () -> Outer {
	return outer
}

func opaque (n: Int32) -> Int32 {
	return n
}


func testTwoRunTimeIndexes () -> Bool {
	let x = outerValue().grid[opaque(1)][opaque(2)]
	if x != 6 {
		printf("outerValue().grid[1][2] = %d, expected 6\n", x)
		return false
	}

	printf("passed: two run-time indexes\n")
	return true
}


func testMixedIndexes () -> Bool {
	let x = outerValue().grid[1][opaque(0)]
	let y = outerValue().grid[opaque(0)][2]
	if x != 4 or y != 3 {
		printf("grid[1][0] = %d, grid[0][2] = %d, expected 4, 3\n", x, y)
		return false
	}

	printf("passed: run-time and compile-time index\n")
	return true
}


func testTwoCompileTimeIndexes () -> Bool {
	let x = outerValue().grid[1][1]
	if x != 5 {
		printf("outerValue().grid[1][1] = %d, expected 5\n", x)
		return false
	}

	printf("passed: two compile-time indexes\n")
	return true
}


func testNestedRecord () -> Bool {
	let x = outerValue().inner.items[opaque(1)]
	let y = outerValue().inner.items[2]
	if x != 200 or y != 300 {
		printf("inner.items[1] = %d, inner.items[2] = %d, expected 200, 300\n", x, y)
		return false
	}

	printf("passed: field of a nested record\n")
	return true
}


func testSlice () -> Bool {
	let s = outerValue().inner.items[1:3]
	if s[0] != 200 or s[1] != 300 {
		printf("inner.items[1:3] = [%d, %d], expected [200, 300]\n", s[0], s[1])
		return false
	}

	printf("passed: slice of a field\n")
	return true
}


func testLoop () -> Bool {
	var sum: Int32 = 0
	var i: Int32 = 0
	while i < 3 {
		sum = sum + outerValue().inner.items[i]
		i = i + 1
	}

	if sum != 600 {
		printf("sum = %d, expected 600\n", sum)
		return false
	}

	printf("passed: index in a loop\n")
	return true
}


func main () -> Int {
	var result = true
	result = testTwoRunTimeIndexes() and result
	result = testMixedIndexes() and result
	result = testTwoCompileTimeIndexes() and result
	result = testNestedRecord() and result
	result = testSlice() and result
	result = testLoop() and result

	if not result {
		printf("failed: field of value paths\n")
		return exitFailure
	}

	printf("passed: field of value paths\n")
	return exitSuccess
}
