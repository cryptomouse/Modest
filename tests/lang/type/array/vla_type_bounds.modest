// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: bounds changed after the declaration
// EXPECT-OUT: passed: value of the type
// EXPECT-OUT: passed: pointer to the type
// EXPECT-OUT: passed: pointer type with a run-time bound
// EXPECT-OUT: passed: first use inside a branch
// EXPECT-OUT: passed: same name in a nested block
// EXPECT-OUT: passed: name taken by the program
// EXPECT-OUT: passed: unnamed array type of a variable
// EXPECT-OUT: passed: unnamed pointer type of a constant
// EXPECT-OUT: passed: bound evaluated once
// EXPECT-OUT: passed: VLA type bounds
// EXPECTED-FAIL(llvm): BUG#110 VLA type bounds are read at each use
//
// A local type with run-time bounds takes their values where its
// declaration runs, as in C: changing the variables afterwards changes
// neither its size nor its layout.  For an unnamed type that is the
// declaration of the variable or constant it is written in.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


var grid: [10][20]Nat32


func testChangedBounds () -> Bool {
	var k: Nat32 = 10
	var l: Nat32 = 20
	type Matrix = [k][l]Nat32
	k = 0
	l = 0

	if sizeof(Matrix) != 800 or lengthof(Matrix) != 10 {
		printf("[10][20]Nat32: sizeof %zu, lengthof %zu, expected 800, 10\n", sizeof(Matrix), lengthof(Matrix))
		return false
	}

	printf("passed: bounds changed after the declaration\n")
	return true
}


func testValue () -> Bool {
	var k: Nat32 = 10
	var l: Nat32 = 20
	type Matrix = [k][l]Nat32
	k = 1
	l = 1

	var a: Matrix
	a[9][19] = 5
	var b: Matrix
	b = a

	if sizeof(a) != 800 or lengthof(a) != 10 or lengthof(a[0]) != 20 or b[9][19] != 5 {
		printf("a: sizeof %zu, lengthof %zu, %zu, b[9][19] = %u, expected 800, 10, 20, 5\n", sizeof(a), lengthof(a), lengthof(a[0]), b[9][19])
		return false
	}

	printf("passed: value of the type\n")
	return true
}


func testPointer () -> Bool {
	var k: Nat32 = 10
	var l: Nat32 = 20
	type Matrix = [k][l]Nat32
	k = 1
	l = 1

	let p = *Matrix *Unit &grid
	p[9][19] = 7

	if sizeof(*p) != 800 or grid[9][19] != 7 {
		printf("*p: sizeof %zu, grid[9][19] = %u, expected 800, 7\n", sizeof(*p), grid[9][19])
		return false
	}

	printf("passed: pointer to the type\n")
	return true
}


func testPointerType () -> Bool {
	var l: Nat32 = 20
	type RowPtr = *[l]Nat32
	l = 1

	let p = RowPtr *Unit &grid
	p[3] = 9

	if sizeof(*p) != 80 or grid[0][3] != 9 {
		printf("*p: sizeof %zu, grid[0][3] = %u, expected 80, 9\n", sizeof(*p), grid[0][3])
		return false
	}

	printf("passed: pointer type with a run-time bound\n")
	return true
}


func testFirstUseInBranch () -> Bool {
	var k: Nat32 = 10
	type Row = [k]Nat32

	var inBranch: Size = 0
	if k > 5 {
		inBranch = sizeof(Row)
	}
	k = 0

	if inBranch != 40 or sizeof(Row) != 40 {
		printf("[10]Nat32: sizeof %zu in the branch, %zu after it, expected 40, 40\n", inBranch, sizeof(Row))
		return false
	}

	printf("passed: first use inside a branch\n")
	return true
}


func testNestedBlock () -> Bool {
	var k: Nat32 = 10
	type Row = [k]Nat32
	k = 1

	var inner: Size = 0
	if true {
		type Row = [k]Nat32
		k = 50
		inner = sizeof(Row)
	}

	if inner != 4 or sizeof(Row) != 40 {
		printf("sizeof %zu inside, %zu outside, expected 4, 40\n", inner, sizeof(Row))
		return false
	}

	printf("passed: same name in a nested block\n")
	return true
}


func testTakenName () -> Bool {
	// the name the backend would give the bound of Row
	type __Row_0 = Nat8

	var k: Nat32 = 10
	type Row = [k]Nat32
	k = 0

	if sizeof(Row) != 40 or sizeof(__Row_0) != 1 {
		printf("sizeof %zu, %zu, expected 40, 1\n", sizeof(Row), sizeof(__Row_0))
		return false
	}

	printf("passed: name taken by the program\n")
	return true
}


func testUnnamedVar () -> Bool {
	var k: Nat32 = 10
	var l: Nat32 = 20
	var a: [k][l]Nat32
	k = 1
	l = 1
	a[9][19] = 5

	if sizeof(a) != 800 or lengthof(a) != 10 or lengthof(a[0]) != 20 or a[9][19] != 5 {
		printf("a: sizeof %zu, lengthof %zu, %zu, a[9][19] = %u, expected 800, 10, 20, 5\n", sizeof(a), lengthof(a), lengthof(a[0]), a[9][19])
		return false
	}

	printf("passed: unnamed array type of a variable\n")
	return true
}


func testUnnamedConst () -> Bool {
	var k: Nat32 = 10
	var l: Nat32 = 20
	let p = *[k][l]Nat32 *Unit &grid
	k = 1
	l = 1
	p[8][18] = 3

	if sizeof(*p) != 800 or grid[8][18] != 3 {
		printf("*p: sizeof %zu, grid[8][18] = %u, expected 800, 3\n", sizeof(*p), grid[8][18])
		return false
	}

	printf("passed: unnamed pointer type of a constant\n")
	return true
}


var calls: Nat32


func countedVolume () -> Nat32 {
	calls += 1
	return 10
}


func testBoundOnce () -> Bool {
	calls = 0
	var a: [countedVolume()]Nat32
	let size = sizeof(a)
	let length = lengthof(a)

	if size != 40 or length != 10 or calls != 1 {
		printf("sizeof %zu, lengthof %zu, %u calls, expected 40, 10, 1\n", size, length, calls)
		return false
	}

	printf("passed: bound evaluated once\n")
	return true
}


func main () -> Int {
	var result = true
	result = testChangedBounds() and result
	result = testValue() and result
	result = testPointer() and result
	result = testPointerType() and result
	result = testFirstUseInBranch() and result
	result = testNestedBlock() and result
	result = testTakenName() and result
	result = testUnnamedVar() and result
	result = testUnnamedConst() and result
	result = testBoundOnce() and result

	if not result {
		printf("failed: VLA type bounds\n")
		return exitFailure
	}

	printf("passed: VLA type bounds\n")
	return exitSuccess
}

