// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: rows of the same length
// EXPECT-OUT: passed: rows of another length
// EXPECT-OUT: passed: three levels
// EXPECT-OUT: passed: array literal into an array with a VLA inside
//
// A generic array literal of rows goes into an array with a run-time
// length below the top: `[2][n]T`, `[n][m]T`, `[n][2][m]T`.  As for a
// plain VLA (vla_literal.modest), at every level the copy takes as many
// items as both the literal and the array have, and the rest is zero:
// a short row gets a zero tail, a row or an item past the run-time
// length is left out.  What a literal of another length should do is
// not decided yet (QUESTION#7).
//
// Every volume goes through `opaque`, so it cannot be folded away.
//
// Guards BUG#115 (fixed 2026-11-03).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


func opaque (n: Nat32) -> Nat32 {
	return n
}


func check (name: *Str8, p: *[]Int32, n: Nat32, want: [4]Int32) -> Bool {
	var i: Nat32 = 0
	while i < n {
		if p[i] != want[i] {
			printf("%s[%u] = %d, expected %d\n", name, i, p[i], want[i])
			return false
		}
		i += 1
	}
	return true
}


func testSameLength () -> Bool {
	let n = opaque(2)
	let x: Int32 = 10

	var a: [2][n]Int32 = [[1, 2], [x, x + 1]]
	var b: [n][n]Int32
	b = [[3, 4], [5, 6]]
	let c: [2][n]Int32 = [[7, 8], [9, 10]]
	var cc: [2][n]Int32 = c
	let d = [n][3]Int32 [[1, 1, 1], [2, 2, 2]]
	var dd: [n][3]Int32 = d

	var ok = true
	ok = check("a[0]", &a[0], n, [1, 2]) and ok
	ok = check("a[1]", &a[1], n, [10, 11]) and ok
	ok = check("b[0]", &b[0], n, [3, 4]) and ok
	ok = check("b[1]", &b[1], n, [5, 6]) and ok
	ok = check("c[0]", &cc[0], n, [7, 8]) and ok
	ok = check("c[1]", &cc[1], n, [9, 10]) and ok
	ok = check("d[1]", &dd[1], 3, [2, 2, 2]) and ok

	if ok {
		printf("passed: rows of the same length\n")
	}
	return ok
}


func testOtherLength () -> Bool {
	// short rows and a missing row: zero
	let n = opaque(3)
	var a: [n][n]Int32 = [[1, 2, 3], [4]]

	// a row past the run-time length is left out, a long row is cut
	let m = opaque(2)
	var b: [m][m]Int32 = [[5, 6, 7], [8], [9, 9, 9]]

	var ok = true
	ok = check("a[0]", &a[0], n, [1, 2, 3]) and ok
	ok = check("a[1]", &a[1], n, [4, 0, 0]) and ok
	ok = check("a[2]", &a[2], n, [0, 0, 0]) and ok
	ok = check("b[0]", &b[0], m, [5, 6]) and ok
	ok = check("b[1]", &b[1], m, [8, 0]) and ok

	if ok {
		printf("passed: rows of another length\n")
	}
	return ok
}


func testThreeLevels () -> Bool {
	let n = opaque(2)
	let m = opaque(3)
	var a: [n][2][m]Int32 = [[[1, 2], [3]], [[4], [5, 6, 7, 8]], [[9]]]

	var ok = true
	ok = check("a[0][0]", &a[0][0], m, [1, 2, 0]) and ok
	ok = check("a[0][1]", &a[0][1], m, [3, 0, 0]) and ok
	ok = check("a[1][0]", &a[1][0], m, [4, 0, 0]) and ok
	ok = check("a[1][1]", &a[1][1], m, [5, 6, 7]) and ok

	if ok {
		printf("passed: three levels\n")
	}
	return ok
}


func main () -> Int {
	var result = true
	result = testSameLength() and result
	result = testOtherLength() and result
	result = testThreeLevels() and result

	if not result {
		printf("failed: array literal into an array with a VLA inside\n")
		return exitFailure
	}

	printf("passed: array literal into an array with a VLA inside\n")
	return exitSuccess
}
