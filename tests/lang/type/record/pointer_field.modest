// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: an array literal of records with a pointer
// EXPECT-OUT: passed: pointer field in an array literal
//
// An array literal whose elements are record literals, where the record
// has a pointer field: `var ops: [2]Op = [{tag = 1, fn = &twice}, ...]`.
//
// A record literal is generic until it is built at a type.  The address
// makes the array literal a non-immediate one, and its elements still
// have to be built at the record — not left at the literal's own type
// `{i8, %Int32*}`, with the `tag` at the literal's width.
//
// One record at a time is what `nested.modest` covers; more run-time
// array literals are in `type/array/literal_runtime_items.modest`.
//
// Guards BUG#49 (fixed 2026-10-31).

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type Op = {
	tag: Int32
	fn: *(a: Int32) -> Int32
}

type Ref = {
	tag: Int32
	p: *Int32
}

var n: Int32 = 5


func twice (a: Int32) -> Int32 {
	return a * 2
}


func negate (a: Int32) -> Int32 {
	return 0 - a
}


func testArrayLiteral () -> Bool {
	// A dispatch table: the shape the pointer-to-function field is for.
	var ops: [2]Op = [{tag = 1, fn = &twice}, {tag = 2, fn = &negate}]
	if ops[0].tag != 1 or ops[1].tag != 2 {
		printf("tags = %d, %d, expected 1 and 2\n", ops[0].tag, ops[1].tag)
		return false
	}
	if ops[0].fn(5) != 10 or ops[1].fn(5) != 0 - 5 {
		printf("calls = %d, %d, expected 10 and -5\n", ops[0].fn(5), ops[1].fn(5))
		return false
	}

	// An ordinary pointer field is the same case.
	var rs: [2]Ref = [{tag = 1, p = &n}, {tag = 2, p = nil}]
	if *rs[0].p != 5 {
		printf("*rs[0].p = %d, expected 5\n", *rs[0].p)
		return false
	}
	if not (rs[1].p == nil) {
		printf("rs[1].p is not nil\n")
		return false
	}

	printf("passed: an array literal of records with a pointer\n")
	return true
}


func main () -> Int {
	if not testArrayLiteral() {
		printf("failed: pointer field in an array literal\n")
		return exitFailure
	}

	printf("passed: pointer field in an array literal\n")
	return exitSuccess
}

