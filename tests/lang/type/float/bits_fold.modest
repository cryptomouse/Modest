// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: folded to bits
// EXPECT-OUT: passed: folded from bits
// EXPECT-OUT: passed: global from bits
// EXPECT-OUT: passed: width change
// EXPECT-OUT: passed: Float16 bits
// EXPECT-OUT: passed: float bits fold
//
// bits.modest reinterprets values known only at run time.  This file covers
// the rest of `FloatY <-> WordX`: constants the compiler folds itself
// (with `struct.pack`, not an integer conversion of the asset), constants
// that end up in a global's static initializer, and a word whose width
// differs from the float's.
//
// The width rule: the bits move only between equal widths, and the width
// then changes on the `WordX` side, the way `WordY -> WordX` does — `zext`
// going wider, truncation going narrower.  So `Word64 Float32 1.0` is the
// Float32 pattern zero-extended, and `unsafe(Float32 Word64 w)` reads the
// low 32 bits of `w`.
//
// `modest` is not in BACKENDS: it stops after code generation, so it would
// pass this file without ever running it.
//
// Guards BUG#36 (fixed 2026-09-28).

pragma unsafe

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


const one32: Float32 = 1.0
const negTwo32: Float32 = -2.0
const one64: Float64 = 1.0

const oneBits32: Word32 = Word32 one32
const oneBits64: Word64 = Word64 one64

const infBits: Word32 = 0x7F800000
const inf32: Float32 = unsafe(Float32 infBits)
const halfFromBits: Float64 = unsafe(Float64 Word64 0x3FE0000000000000)

// Static initializers: nothing to run here, the value has to be folded.
var globalBits: Word32 = Word32 negTwo32
var globalFloat: Float32 = unsafe(Float32 Word32 0x3F800000)


func check32 (name: *ConstCharStr, got: Word32, expected: Word32) -> Bool {
	if got == expected {
		return true
	}
	printf("%s = 0x%08x, expected 0x%08x\n", name, got, expected)
	return false
}


func check64 (name: *ConstCharStr, got: Word64, expected: Word64) -> Bool {
	if got == expected {
		return true
	}
	printf("%s = 0x%016llx, expected 0x%016llx\n", name, got, expected)
	return false
}


func testFoldedToBits () -> Bool {
	var ok = true
	ok = check32("const Word32 of 1.0", oneBits32, 0x3F800000) and ok
	ok = check64("const Word64 of 1.0", oneBits64, 0x3FF0000000000000) and ok
	ok = check32("Word32 of const -2.0", Word32 negTwo32, 0xC0000000) and ok
	if not ok {
		return false
	}
	printf("passed: folded to bits\n")
	return true
}


func testFoldedFromBits () -> Bool {
	var big: Float32 = 100000000000000000000000000000.0
	if not (inf32 > big) {
		printf("const from 0x7F800000 is not above a finite value\n")
		return false
	}
	if halfFromBits != 0.5 {
		printf("const from 0x3FE0000000000000 = %f, expected 0.5\n", halfFromBits)
		return false
	}
	// Folded out and back in: the pattern survives the round trip.
	if not check32("round trip", Word32 inf32, 0x7F800000) {
		return false
	}
	printf("passed: folded from bits\n")
	return true
}


func testGlobal () -> Bool {
	var ok = check32("global Word32 of -2.0", globalBits, 0xC0000000)
	if Float64 globalFloat != 1.0 {
		printf("global from 0x3F800000 = %f, expected 1.0\n", Float64 globalFloat)
		ok = false
	}
	if not ok {
		return false
	}
	printf("passed: global from bits\n")
	return true
}


func testWidthChange () -> Bool {
	var ok = true

	// Wider word: the Float32 pattern, zero-extended — not the Float64 one.
	var one: Float32 = 1.0
	ok = check64("Word64 of Float32 1.0", Word64 one, 0x000000003F800000) and ok

	var negTwo: Float32 = -2.0
	ok = check64("Word64 of Float32 -2.0", Word64 negTwo, 0x00000000C0000000) and ok

	// Narrower word: the low bits of the pattern.
	var tenth: Float64 = 0.1
	ok = check32("Word32 of Float64 0.1", unsafe(Word32 tenth), 0x9999999A) and ok

	// Narrower float: the low 32 bits of the word, the high ones dropped.
	var w: Word64 = 0xFFFFFFFF3F800000
	var f: Float32 = unsafe(Float32 w)
	if Float64 f != 1.0 {
		printf("Float32 of 0xFFFFFFFF3F800000 = %f, expected 1.0\n", Float64 f)
		ok = false
	}

	// The same, folded.
	ok = check64("const Word64 of Float32 1.0", Word64 one32, 0x000000003F800000) and ok
	var g: Float32 = unsafe(Float32 Word64 0xFFFFFFFF3F800000)
	if Float64 g != 1.0 {
		printf("folded Float32 of 0xFFFFFFFF3F800000 = %f, expected 1.0\n", Float64 g)
		ok = false
	}

	if not ok {
		return false
	}
	printf("passed: width change\n")
	return true
}


// Float16: 1 sign bit, 5 exponent bits, 10 significand bits.
func testFloat16 () -> Bool {
	var ok = true

	var one: Float16 = 1.0
	ok = check32("Float16 1.0", Word32 Word16 one, 0x3C00) and ok

	var negTwo: Float16 = -2.0
	ok = check32("Float16 -2.0", Word32 Word16 negTwo, 0xC000) and ok

	let folded: Float16 = 1.0
	ok = check32("folded Float16 1.0", Word32 Word16 folded, 0x3C00) and ok

	var w: Word16 = 0x3800
	var half: Float16 = unsafe(Float16 w)
	if Float64 half != 0.5 {
		printf("Float16 of 0x3800 = %f, expected 0.5\n", Float64 half)
		ok = false
	}

	if not ok {
		return false
	}
	printf("passed: Float16 bits\n")
	return true
}


func main () -> Int {
	var result = true
	result = testFoldedToBits() and result
	result = testFoldedFromBits() and result
	result = testGlobal() and result
	result = testWidthChange() and result
	result = testFloat16() and result

	if not result {
		printf("failed: float bits fold\n")
		return exitFailure
	}

	printf("passed: float bits fold\n")
	return exitSuccess
}

