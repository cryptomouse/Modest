// TEST: reject
// EXPECT-ERROR: undefined type
// EXPECT-ERROR: undefined value 'nosuch'
// EXPECT-ERROR: undefined type
// EXPECT-ERROR-COUNT: 3
//
// A type alias whose right-hand side is bad is reported once, at the
// definition; a variable of that type is then as silent as a bad value:
//
//	type A = Zzz   // error: undefined type
//	var a: A
//	a = 1          // no "use of incomplete value" here
//
// It used to stay incomplete, so every use added that error.  A local
// alias is the same: it is still declared, so its uses do not add
// "undefined type".
//
// Guards BUG#130 (fixed 2026-11-19).

include "libc/ctypes64"

type A = Zzz
type B = [nosuch]Int32


func main () -> Int {
	var a: A
	a = 1

	var b: B
	b = [1, 2]

	type L = Zzz
	var c: L
	c = 1
	return 0
}

