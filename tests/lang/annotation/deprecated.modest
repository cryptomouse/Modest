// TEST: run
// BACKENDS: c11, llvm, modest
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: deprecated
//
// @deprecated only warns at use sites: a program that uses deprecated
// definitions of every kind still compiles and runs as usual.  Which uses
// warn is checked by reject_deprecated.modest.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


@deprecated
type Old = Int32

@deprecated
const oldConst: Int32 = 2

@deprecated
var oldVar: Int32 = 3


func useEarly () -> Int32 {
	let a: Old = oldFn()
	return a + oldConst + oldVar
}


@deprecated
func oldFn () -> Int32 {
	return 1
}


func main () -> Int {
	let x = useEarly()
	if x != 6 {
		printf("x = %d, expected 6\n", x)
		printf("failed: deprecated\n")
		return exitFailure
	}

	printf("passed: deprecated\n")
	return exitSuccess
}

