// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: include same type
// Guards BUG#105 (fixed 2026-10-24).
//
// `./_include_same_type/types` includes `libc/ctypes64` and then defines
// `UIDT` once more, the same way.  The C backend prints neither (an
// included module is never printed in C); the LLVM backend used to print
// both: `%UIDT = type %Nat32` twice, which LLVM refuses as a redefinition
// of type — before anything here is even used, so the program does not
// use `UIDT` at all.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"
include "./_include_same_type/types"


func main () -> Int {
	printf("passed: include same type\n")
	return exitSuccess
}

