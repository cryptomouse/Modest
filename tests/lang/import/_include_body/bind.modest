// A binding module whose function has a body and no C counterpart:
// nothing but this module defines `twice`.  Used by
// `include_func_body.modest`.

pragma do_not_include
pragma prefix ""


// @impure: `twice(21)` would be folded at compile time otherwise, and
// the test would never reach the body that is not emitted
@impure
public func twice (x: Int32) -> Int32 {
	return x * 2
}

