// TEST: run
// BACKENDS: c11, llvm
// EXPECT-EXIT: 0
// EXPECT-OUT: passed: converted call result
// EXPECT-OUT: passed: compared call result
// EXPECT-OUT: passed: returned array
// EXPECT-OUT: passed: stack temporary
// EXPECTED-FAIL(llvm): BUG#96 a temporary slot inside a loop is allocated anew on every iteration
//
// A loop that runs millions of times, each iteration needing a temporary
// slot on the stack: a call result put under another record name, a call
// result compared with `==`, and an array returned through a buffer.
//
// The slot must be taken once for the whole function.  The LLVM backend
// emits its `alloca` where the value is needed, in the middle of the loop
// body, and an `alloca` outside the entry block is not released until the
// function returns: the stack grows by one slot per iteration and the
// program runs out of it.
//
// The slots of `var` and `let` are already taken in the entry block; that
// is `stack_local.modest`.

include "libc/ctypes64"
include "libc/stdio"
include "libc/stdlib"


type Point = {
	x: Int32
	y: Int32
}

type Vec2 = {
	x: Int32
	y: Int32
}


// Enough iterations that one slot of 8 bytes each is far past a usual
// 8 MiB stack.
const iterations: Int32 = 4000000


func makeVec (x: Int32, y: Int32) -> Vec2 {
	var v: Vec2 = {x = x, y = y}
	return v
}


func makePair (x: Int32) -> [2]Int32 {
	var a: [2]Int32 = [x, 1]
	return a
}


func testConverted () -> Bool {
	var p: Point = {}
	var sum: Int32 = 0
	var i: Int32 = 0
	while i < iterations {
		p = makeVec(1, 1)
		sum = sum + p.x
		i = i + 1
	}

	if sum != iterations {
		printf("sum = %d, expected %d\n", sum, iterations)
		return false
	}

	printf("passed: converted call result\n")
	return true
}


func testCompared () -> Bool {
	var v: Vec2 = {x = 1, y = 1}
	var equal: Int32 = 0
	var i: Int32 = 0
	while i < iterations {
		if v == makeVec(1, 1) {
			equal = equal + 1
		}
		i = i + 1
	}

	if equal != iterations {
		printf("equal = %d, expected %d\n", equal, iterations)
		return false
	}

	printf("passed: compared call result\n")
	return true
}


func testReturnedArray () -> Bool {
	var sum: Int32 = 0
	var i: Int32 = 0
	while i < iterations {
		let a = makePair(1)
		sum = sum + a[1]
		i = i + 1
	}

	if sum != iterations {
		printf("sum = %d, expected %d\n", sum, iterations)
		return false
	}

	printf("passed: returned array\n")
	return true
}


func main () -> Int {
	var ok = testConverted()
	ok = testCompared() and ok
	ok = testReturnedArray() and ok

	if not ok {
		printf("failed: stack temporary\n")
		return exitFailure
	}

	printf("passed: stack temporary\n")
	return exitSuccess
}
